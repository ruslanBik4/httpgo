n.usr-table__t-head .usr-table-col.sortable:hover span::before, span.sorted-desc::before {\n    content: '\\F574';\n    cursor: s-resize;\n}\n\n.usr-table__t-head .usr-table-col.sortable:hover span::after, span.sorted-asc::after {\n    content: \"\\f57b\";\n    cursor: n-resize;\n}\n\n.usr-table-row {\n    display: flex;\n    flex-direction: row;\n    justify-content: flex-start;\n    gap: 2px;\n    transition: .3s;\n    text-decoration: none !important;\n    color: #232b2f;\n    box-sizing: content-box;\n    border-bottom: 1px solid #e5e5e5;\n}\n\n.usr-table-row:nth-child(2n) {\n    background-color: rgba(120, 147, 182, 0.1);\n}\n\n.usr-table-col {\n    padding: 2px;\n    align-content: center;\n    max-height: 100px;\n    overflow: hidden;\n    word-break: break-all;\n    box-sizing: content-box;\n}\n\n.usr-table-col input {\n    width: 98%;\n}\n\n.usr-table-col p {\n    margin: 1%;\n    padding: 0;\n}\n\n.usr-table-col:hover {\n    overflow-y: visible;\n}\n\n.usr-table {\n    background-color: #ffffff;\n    box-shadow: 0 2px 2px 0 rgba(36, 53, 65, 0.1), 0 0 2px 0 rgba(36, 53, 65, 0.1);\n    border: solid 1px rgba(229, 229, 229, 0.1);\n    border-top: none;\n    font-size: 15px;\n    font-weight: 600;\n    line-height: 1.8;\n    letter-spacing: 0.2px;\n    text-align: left;\n    color: #232b2f;\n    margin: 0 1px;\n    display: flex;\n    flex-direction: column;\n    border-bottom-color: #f3f3f3;\n}\n\n.usr-table .usr-table-col {\n    /*align-self: center;*/\n    box-shadow: 0 2px 2px 0 rgba(36, 53, 65, 0.1), 0 0 2px 0 rgba(36, 53, 65, 0.1);\n    justify-content: center;\n    text-align: center;\n}\n\n.usr-table .usr-table-row .usr-table-col:nth-child(1), .usr-table .usr-table__t-head > .usr-table-col:nth-child(1) {\n    position: sticky;\n    left: 0;\n    padding-left: 3px;\n    z-index: 1;\n    /*text-align: center;*/\n    /*justify-content: center;*/\n    background-color: #f3f3f3;\n}\n\n.usr-table__filter {\n    background-color: #f3f3f3;\n}\n\n.usr-table__filter .usr-table-col {\n    justify-content: center;\n    padding: 0 1px;\n}\n\n.usr-table__filter .usr-table-col input[type=text] {\n    width: 98%;\n}\n\n.filt-arrow {\n    display: flex;\n    padding: 2px;\n    width: 98%;\n    height: 98%;\n    justify-content: center;\n}\n\ndiv.filt-arrow > input[type=number]::-webkit-outer-spin-button, div.filt-arrow > input[type=number]::-webkit-inner-spin-button {\n    /* hide arrows\n     Chrome, Safari, Edge, Opera */\n    -webkit-appearance: none !important;\n    margin: 0 !important;\n    /* Firefox */\n    -moz-appearance: textfield !important;\n}\n\ndiv.filt-arrow > input[type=search], div.filt-arrow > input[type=text], div.filt-arrow > input[type=email], div.filt-arrow > input {\n    width: 98%;\n    height: 25px;\n    padding: 2px;\n    margin: 1px 1px 10px 1px;\n}\ndiv.filt-arrow > input[type=checkbox] {\n    width: fit-content;\n}\n.filt-arrow__link.active::before {\n    border-color: #229be6;\n}\n\n.filt-arrow__link {\n    width: 24px;\n    height: 24px;\n    position: relative;\n    display: block;\n}\n\n.filt-arrow__link .arrow-top:before {\n    content: '';\n    display: block;\n    width: 7px;\n    height: 7px;\n    border: 1px solid #4a4a4a;\n    border-left: none;\n    border-bottom: none;\n    transform: rotate(-45deg);\n    right: 0;\n    left: 0;\n    margin: auto;\n    top: 6px;\n    bottom: 0;\n    position: absolute;\n    transition: .3s;\n}\n\n.filt-arrow__link .arrow-bottom:before {\n    content: '';\n    display: block;\n    width: 7px;\n    height: 7px;\n    border: 1px solid #4a4a4a;\n    border-left: none;\n    border-bottom: none;\n    --webkit-transform: rotate(134deg);\n    transform: rotate(134deg);\n    right: 0;\n    left: 0;\n    margin: auto;\n    top: 0;\n    bottom: 2px;\n    position: absolute;\n    transition: .3s;\n}\n\n.avatar-table {\n    width: 60px;\n    height: 60px;\n    border: solid 1px rgba(0, 0, 0, 0.1);\n    display: block;\n    border-radius: 50%;\n    position: relative;\