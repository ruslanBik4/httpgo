          "content": {
            "size": 79186,
            "compression": -45,
            "mimeType": "application/json",
            "text": "\n // journal-table.js version 11.08\nclass JournalTable {\n\n    constructor() {\n        this.state = {\n            content: null,\n            cfg: null,\n\n            leftCanvas: null,\n            mainCanvas: null,\n            leftCtx: null,\n            mainCtx: null,\n\n            headers: [],\n            leafHeaders: [],\n            topHeaders: [],\n\n            groupBy: null,\n            rawRows: [],\n            view: [],\n\n            colWidths: [],\n            colOffsets: [],\n\n            rowHeight: 32,\n            headerHeight: 60,\n            buffer: 5,\n            scale:  1,\n            leftHeaderCanvas: null,\n            mainHeaderCanvas: null,\n            leftHeaderCtx: null,\n            mainHeaderCtx: null,\n\n            pinnedCount: 1,\n            sortState: { col: null, dir: 'asc' },\n            hoverCol: null,\n            trades: {}\n        };\n\n        this._headerCells = [];\n    }\n\n    init(container, tables) {\n\n        this.state.tables = tables;\n        let table = tables[0];\n        this.state.container = container;\n        if (!this.state.container) return;\n\n        this.state.container._journalTable = this;\n\n        this.state.content = this.getHostByName('usr-table-content-scroll');\n        if (!this.state.content) return;\n\n        this.state.headers = table.Header;\n        this.state.totalHost = this.getHostByName('usr-table-footer');\n        this.state.headerHost = this.getHostByName('usr-table-header');\n        if (!this.state.headerHost) {\n            this.state.headerHost = document.createElement('div');\n            this.state.headerHost.className = 'usr-table-header';\n            this.state.headerHost.setAttribute('data-name', 'usr-table-header');\n            this.state.container.prepend(this.state.headerHost);\n        } else {\n            // this.state.headerHeight = getComputedStyle(this.state.headerHost, 'height');\n        }\n\n        this.state.totals = table.Total || [];\n        this.state.cfg = table.Settings || [];\n        this.state.headers = table.Header || [];\n        this.state.groupBy = table.Settings?.group || null;\n        this.state.sort = table.Settings?.sort || null;\n\n        this.buildColumns();\n        this.state.colWidths = this.state.leafHeaders.map(() => 140);\n        this.computeColumnOffsets();\n        if (this.state.sort?.name) {\n            this.state.sortState = { col: this.state.leafHeaders.findIndex( h => h.name === this.state.sort.name), dir: this.state.sort.order ?? \"asc\"};\n        }\n\n\n        this.normalize(tables);\n        this.applySort();\n        this.buildView();\n        this.autoFitColumns();   // measure content → set colWidths\n        this.computeRowHeights(); // variable row heights for wrapped text\n\n        this.setupDOM();\n        this.setupFilterControls();  // wire change listeners on filter radios\n        this.render();\n        this.renderHeader(); // 🔥 required\n        this.renderTotal(); // 🔥 required\n\n    }\n\n    // renderHeader draws a two-row canvas header:\n    //   top row    (0..topH)       — group (topHeader) labels\n    //   bottom row (topH..headerH) — leaf column labels\n    // Single leaf columns (kind='single') span the full height.\n    // Group filter: a group header cell is hidden when ALL its leaf children\n    // have colWidth=0 (i.e. filtered out).\n    renderHeader() {\n        const {\n            leafHeaders, topHeaders, headerHeight,\n            colWidths, colOffsets, pinnedCount,\n        } = this.state;\n\n        const scrollLeft  = this.state.content?.scrollLeft ?? 0;\n        const baseOffset  = colOffsets[pinnedCount];\n\n        const ctxL = this.state.leftHeaderCtx;\n        const ctxM = this.state.mainHeaderCtx;\n        if (!ctxL || !ctxM) return;\n\n        this.clear(ctxL, this.state.leftHeaderCanvas);\n        this.clear(ctxM, this.state.mainHeaderCanvas);\n\n        const topH     = headerHeight / 2;   // 30px group row\n        const botH     = headerHeight / 2;   // 30px leaf row\n        const arrowOffX = 10;\n\n        const sortCol = this.state.sortState.col;\n        const sortDir = this.state.sortState.dir;\n        const hoverCol = this.state.hoverCol;\n\n        const drawIndicator = (ctx, i, x, w, midY) => {\n            if (i === sortCol) {\n                // Active sort — solid red/green\n                const fn = sortDir === 'asc' ? this.drawTriangleUp : this.drawTriangleDown;\n                fn.call(this, ctx, x + w - arrowOffX, midY, sortDir === 'asc' ? '#e05' : '#0a0');\n            } else if (i === hoverCol) {\n                this.drawTriangleUp(ctx, x + w - arrowOffX, midY, 'rgba(74,144,217,0.45)');\n            }\n        };\n\n        // Helper: draw one leaf cell in the appropriate row\n        const drawLeaf = (ctx, i, x, w, isSingle) => {\n            if (w === 0) return;\n            const y   = isSingle ? 0 : topH;\n            const h   = isSingle ? headerHeight : botH;\n            const mid = y + h / 2;\n            ctx.strokeStyle = '#ccc';\n            ctx.strokeRect(x, y, w, h);\n            ctx.fillStyle = '#333';\n            ctx.fillText(leafHeaders[i].title, x + w / 2, mid);\n            drawIndicator(ctx, i, x, w, mid);\n        };\n\n        // Helper: draw a group header cell spanning colSpan visible children\n        const drawGroup = (ctx, th, x, w) => {\n            if (w === 0) return;\n            ctx.fillStyle = '#f0f4ff';\n            ctx.fillRect(x, 0, w, topH);\n            ctx.strokeStyle = '#aac';\n            ctx.strokeRect(x, 0, w, topH);\n            ctx.fillStyle = '#333';\n            ctx.fillText(th.title, x + w / 2, topH / 2);\n        };\n\n        // Build a map: leafIndex → whether its topHeader is 'single'\n        const isSingleLeaf = new Array(leafHeaders.length).fill(false);\n        topHeaders.forEach(th => {\n            if (th.kind === 'single') isSingleLeaf[th.start] = true;\n        });\n\n        // ── PINNED (left canvas) ─────────────────────────────────────────\n        ctxL.textAlign = 'center';\n        let x = 0;\n        for (let i = 0; i < pinnedCount; i++) {\n            const w = colWidths[i];\n            drawLeaf(ctxL, i, x, w, isSingleLeaf[i]);\n            if (w > 0) x += w;\n        }\n\n        // ── MAIN (scrollable) canvas ─────────────────────────────────────\n        ctxM.textAlign = 'center';\n\n        // Draw leaf cells first\n        for (let i = pinnedCount; i < leafHeaders.length; i++) {\n            const w = colWidths[i];\n            const lx = colOffsets[i] - baseOffset - scrollLeft;\n            drawLeaf(ctxM, i, lx, w, isSingleLeaf[i]);\n        }\n\n        // Draw group header cells on top (top row only)\n        topHeaders.forEach(th => {\n            if (th.kind !== 'group') return;\n\n            // Visible width = sum of visible children widths\n            let gx = null, gw = 0;\n            for (let i = th.start; i < th.start + th.span; i++) {\n            const w = colWidths[i];\n            if (w === 0) continue;\n                const lx = colOffsets[i] - baseOffset - scrollLeft;\n                if (gx === null) gx = lx;\n                gw += w;\n        }\n            if (gx === null || gw === 0) return;  // all children hidden — skip group\n\n            const ctx = th.start < pinnedCount ? ctxL : ctxM;\n            drawGroup(ctx, th, gx, gw);\n        });\n    }\n\n    applySort() {\n        const sort = this.state.sort;\n        if (!sort) return;\n\n        const idx = this.state.leafHeaders.findIndex(h => h.name === sort.name);\n        if (idx < 0) return;\n\n        const dir = sort.order === 'desc' ? -1 : 1;\n\n        function getCmp(av, bv, dir) {\n            if (typeof av === 'number' && typeof bv === 'number') {\n                return dir * (av - bv);\n            }\n\n            const as = av == null ? '' : String(av);\n            const bs = bv == null ? '' : String(bv);\n            return dir * as.localeCompare(bs);\n        }\n\n        this.state.rawRows.sort((a, b) => {\n            const bv = b.values;\n            const av = a.values;\n            let cmp = a.__group !== undefined ? getCmp(a.__group, b.__group, 1) : 0;\n            if (cmp !== 0) {\n                return cmp;\n            }\n\n            if (a.type === 'total') {\n                return 1;\n            }\n            if (b.type === 'total') {\n                return -1;\n            }\n\n            return getCmp(av[idx], bv[idx], dir);\n        });\n    }\n\n    // getHostByName finds the first element with data-name=\"name\" inside scope.\n    // Replaces $('[data-name=\"...\"]', container)[0] — no jQuery needed.\n    getHostByName(name, scope) {\n        return (scope ?? this.state.container).querySelector(`[data-name=\"${name}\"]`);\n    }\n\n\n    // ================= COLUMNS =================\n    buildColumns() {\n        const topHeaders = [];\n        const leafHeaders = [];\n\n        this.state.headers.forEach((h) => {\n            if (Array.isArray(h.children) && h.children.length > 0) {\n                const start = leafHeaders.length;\n\n                topHeaders.push({\n                    kind: 'group',\n                    title: h.title || h.name || '',\n                    start,\n                    span: h.children.length,\n                    name: h.name\n                });\n\n                h.children.forEach((childName) => {\n                    leafHeaders.push({\n                        name: childName,\n                        title: childName,\n                        type: h.type || 'string',\n                        total: h.total,\n                        link: h.link,\n                        component: h.component,\n                        defaultHidden: h.defaultHidden || false,\n                        parent: h.name\n                    });\n                });\n            } else {\n                const start = leafHeaders.length;\n\n                topHeaders.push({\n                    kind: 'single',\n                    title: h.title || h.name || '',\n                    start,\n                    span: 1,\n                    name: h.name\n                });\n\n                leafHeaders.push({\n                    ...h,\n                    title: h.title || h.name || ''\n                });\n            }\n        });\n\n        this.state.topHeaders = topHeaders;\n        this.state.leafHeaders = leafHeaders;\n    }\n\n    computeColumnOffsets() {\n        const offsets = [];\n        let x = 0;\n\n        this.state.colWidths.forEach(w => {\n            offsets.push(x);\n            x += w;\n        });\n\n        this.state.colOffsets = offsets;\n    }\n\n    normalize(tables) {\n\n        this.state.rawRows = [];\n\n        this.createGroupSelector();\n\n        tables.forEach((table) => {\n            const data = table.Data;\n            if (table.Title === 'Total') {\n                this.state.totals = data?.[0];\n                return;\n            }\n\n            let title = table?.Title;\n            if (typeof title === 'object') {\n                if (title.title) {\n                    if (title.type === 'date') {\n                        title = (UnixTimetoDate(title.title));\n                    } else {\n                        title = (title.title);\n                    }\n                }\n            }\n            this.buildGroupSelect(title);\n\n            const group = this.state.groupBy ? table.Title?.title : null;\n            data.forEach((row) => {\n                return (\n                    this.state.rawRows.push({\n                        values: row,\n                        __group: group,\n                        type:  row?.type ?? \"row\",\n                    }));\n            });\n\n            if (tables.length > 1) {\n                this.state.rawRows.push({\n                    values: table.Total,\n                    __group: group,\n                    type: 'total'\n                });\n            }\n        });\n        this.state.filterTitle.replaceChildren(this.state.groupSelect);\n    }\n\n    createGroupSelector() {\n        const filterTitle = this.getHostByName('usr-table-filter', document)?.querySelector(':first-child');\n        if (!filterTitle) return;\n        // Save the filter panel host once — all filter methods use state.filterHost\n        this.state.filterHost = filterTitle.closest('[data-name=\"usr-table-filter\"]') || filterTitle.parentElement;\n\n        const groupSelect = document.createElement('select');\n        Object.assign(groupSelect.style, {\n            fontSize:     '12px',\n            padding:      '2px 6px',\n            border:       '1px solid #ccc',\n            borderRadius: '3px',\n            cursor:       'pointer',\n            background:   '#fff',\n        });\n\n        const option = document.createElement(\"option\");\n        option.textContent = `Go to ${this.state.groupBy}`;\n        option.value = -1;\n        option.disabled = true;\n        option.selected = true;\n        groupSelect.appendChild(option);\n\n        const {rowOffsets, rowHeight} = this.state;\n        groupSelect.addEventListener('change', () => {\n            const rowIndex = parseInt(groupSelect.value, 10);\n            const y = rowOffsets ? rowOffsets[rowIndex] : rowIndex * rowHeight;\n            this.state.content.scrollTop = y;\n        });\n\n        this.state.groupSelect = groupSelect;\n        this.state.filterTitle = filterTitle;\n\n    }\n    // setupFilterControls wires change listeners on all [name=\"columns\"] radio\n    // inputs found inside this.state.container.\n    // This replaces onclick=\"showColumns(this)\" in the HTML — the class owns\n    // the connection to its own controls so no DOM traversal is needed.\n    setupFilterControls() {\n        const filterHost = this.state.filterHost;\n        if (!filterHost) return;\n\n        filterHost.querySelectorAll('input[name=\"columns\"]').forEach(radio => {\n            radio.addEventListener('change', () => {\n                this.applyColumnFilter(\n                    radio.dataset.columns        || null,\n                    radio.dataset.hidden_columns || null\n                );\n            });\n        });\n    }\n\n\n    // applyColumnFilter(whitelist, blacklist) shows/hides columns without\n    // rebuilding the full table.  Hidden columns get colWidth=0 — zero-width\n    // cells draw nothing and contribute no x offset, so all existing rendering\n    // code skips them naturally.\n    //\n    // whitelist  — comma-separated column names to show (others hidden).\n    //              Pinned columns are always kept visible regardless.\n    // blacklist  — comma-separated column names to hide (others shown).\n    //              Used only when whitelist is empty/null.\n    // Pass both null to restore all columns.\n    applyColumnFilter(whitelist, blacklist) {\n        const { leafHeaders, fittedColWidths, pinnedCount } = this.state;\n        if (!fittedColWidths) return;   // autoFitColumns hasn't run yet\n\n        let visible = null;  // null = show all\n\n        if (whitelist) {\n            visible = new Set(whitelist.split(',').map(s => s.trim()).filter(Boolean));\n            // Pinned columns are structural — always visible\n            for (let i = 0; i < pinnedCount; i++) visible.add(leafHeaders[i].name);\n        } else if (blacklist) {\n            const hidden = new Set(blacklist.split(',').map(s => s.trim()).filter(Boolean));\n            visible = new Set(leafHeaders.map(h => h.name).filter(n => !hidden.has(n)));\n        }\n\n        this.state.colWidths = leafHeaders.map((h, i) =>\n            (!visible || visible.has(h.name)) ? fittedColWidths[i] : 0\n        );\n        this.computeColumnOffsets();\n\n        const totalWidth = this.sumWidths(0, leafHeaders.length);\n        if (this.state.spacer) this.state.spacer.style.width = `${totalWidth}px`;\n\n        this.resizeHeaderCanvas();\n        this.resizeCanvas();\n        this.renderHeader();\n        this.render();\n        this.renderTotal();\n    }\n\n\n    // buildGroupSelect creates a <select> from group keys and places it in\n    // [data-name=\"usr-table-filter\"] :first-child.\n    // Selecting an entry scrolls content to that group row.\n    buildGroupSelect(label) {\n\n        const opt = document.createElement('option');\n        opt.value = this.state.rawRows.length;\n        opt.textContent = label;\n        this.state.groupSelect.appendChild(opt);\n\n    }\n\n    buildView() {\n        const rawRows = this.state.rawRows || [];\n        const groupBy = this.state.groupBy;\n\n        if (!groupBy) {\n            this.state.view = rawRows.map(row => ({type: row?.type ?? 'row', data: row}));\n            return;\n        }\n\n        const view = [];\n        let currentGroup = undefined;\n        let groupRows = [];\n\n        for (const row of rawRows) {\n            const rowGroup = row.__group;\n            if (row.type === 'total') {\n                row.values.unshift('∑ '+this.groupLabel(currentGroup));\n                view.push({\n                    type: row.type,\n                    key: currentGroup,\n                    data: row\n                });\n                continue;\n            }\n\n            if (rowGroup !== currentGroup) {\n                if (groupRows.length > 0) {\n                    console.log({\n                        type: 'total',\n                        key:  currentGroup,\n                        data: { values: this.calcTotal(groupRows) }\n                    });\n                }\n\n                currentGroup = rowGroup;\n                groupRows = [];\n\n                if (currentGroup !== null && currentGroup !== undefined) {\n                    view.push({\n                        type: 'group',\n                        key: currentGroup,\n                        data: {}\n                    });\n                }\n            }\n\n            // toggle-row: header shows row.title + +/- button.\n            // row.values (when present) is the pre-loaded child row shown on expand.\n            // row.link  (when present) is called on first expand if no values yet.\n            if (row.type === 'toggle-row') {\n                const vals    = Array.isArray(row.values) ? row.values : [];\n                const children = vals.length ? [{\n                    type: 'toggle-child',\n                    key:  currentGroup,\n                    data: { values: vals }  // rowValues({values:vals}) → vals\n                }] : [];\n\n                // defaultHidden:true  → start collapsed\n                // defaultHidden:false/undefined → start expanded (if children exist)\n                const startExpanded = !row.defaultHidden && children.length > 0;\n\n                view.push({\n                    type:     'toggle-row',\n                    expanded: startExpanded,\n                    key:      currentGroup,\n                    data:     row,\n                    children: children\n                });\n\n                if (startExpanded) view.push(...children);  // already visible\n\n                continue;  // not a normal data row — don't include in groupRows total\n            }\n\n            groupRows.push(row);\n            view.push({\n                type: 'row',\n                key:  currentGroup,\n                data: row\n            });\n        }\n\n        if (groupRows.length > 0 && this.state.tables.length > 1) {\n            view.push({\n                type: 'total',\n                key:  currentGroup,\n                data: { values: this.calcTotal(groupRows) }\n            });\n        }\n\n        this.state._baseView = [...view]; // snapshot for toggle rebuilds\n        this.state.view = view;\n    }\n\n    // ── Auto-fit column widths to content ────────────────────────────────────\n    // Uses an offscreen canvas to measure rendered text so widths match exactly\n    // what drawCell() will paint. Call after normalize() + applySort().\n    autoFitColumns() {\n        const { leafHeaders, topHeaders, rawRows } = this.state;\n        if (!leafHeaders.length || !rawRows.length) return;\n\n        const FONT      = '12px sans-serif';\n        const FONT_HDR  = '12px sans-serif';  // same font used in renderHeaderOnce cells\n        const PAD       = 16;   // px left+right padding per cell\n        const ARROW_W   = 16;   // extra width for the sort arrow on sortable leaf cells\n        const MIN_WIDTH = 40;\n        const MAX_WIDTH = 300;\n\n        // Offscreen canvas — same font as drawCell/clear()\n        const ofc    = document.createElement('canvas');\n        const ctx    = ofc.getContext('2d');\n\n        const measure = (text, font) => {\n            if (text == null || text === '') return 0;\n            ctx.font = font;\n            return ctx.measureText(String(text)).width;\n        };\n\n        // ── 1. Seed from leaf header titles (+ arrow room) ────────────\n        const widths = leafHeaders.map(h =>\n            measure(h.title || h.name, FONT_HDR) + ARROW_W\n        );\n\n        // ── 2. Group (top) headers: distribute title width equally across\n        //       spanned leaf columns so the group label is never clipped.\n        topHeaders.forEach(th => {\n            if (th.kind !== 'group' || th.span < 1) return;\n            const needed    = measure(th.title, FONT_HDR) + PAD;  // total px the label needs\n            const perChild  = needed / th.span;                     // fair share per leaf\n            for (let i = th.start; i < th.start + th.span; i++) {\n                if (perChild > widths[i]) widths[i] = perChild;\n            }\n        });\n\n        // ── 3. Helper: measure a raw cell value the way drawCell/format() does ─\n        ctx.font = FONT;\n        const measureVal = (raw) => {\n            if (raw == null || raw === '') return 0;\n            let text;\n            if (typeof raw === 'number') {\n                    text = raw.toLocaleString();\n                } else if (typeof raw === 'object' && raw.title != null) {\n                    text = String(raw.title);\n                } else if (Array.isArray(raw)) {\n                    text = raw.join(',');\n                } else {\n                    text = String(raw);\n                }\n            return ctx.measureText(text).width;\n        };\n\n        // ── 4. Walk rawRows (data rows) ───────────────────────────────\n        rawRows.forEach(row => {\n            const vals = this.rowValues(row);\n            leafHeaders.forEach((h, i) => {\n                const w = measureVal(vals[i]);\n                if (w > widths[i]) widths[i] = w;\n            });\n        });\n\n        // ── 5. Walk view rows — captures group labels & total rows ────\n        // (buildView() must have been called before autoFitColumns)\n        (this.state.view || []).forEach(item => {\n            if (item.type === 'group') {\n                const w = ctx.measureText(String(this.groupLabel(item.key))).width;\n                if (w > widths[0]) widths[0] = w;\n                return;\n            }\n            const vals = this.rowValues(item.data);\n            leafHeaders.forEach((h, i) => {\n                const w = measureVal(vals[i]);\n                if (w > widths[i]) widths[i] = w;\n            });\n        });\n\n        this.state.colWidths = widths.map(w =>\n            Math.min(MAX_WIDTH, Math.max(MIN_WIDTH, Math.ceil(w) + PAD))\n        );\n        this.state.fittedColWidths = [...this.state.colWidths];\n        this.computeColumnOffsets();\n    }\n\n    calcTotal(rows) {\n        return this.state.leafHeaders.map((h, i) => {\n            if (!h.total) return '';\n\n            const nums = rows\n                .map(r => this.rowValues(r)[i])\n                .filter(v => typeof v === 'number');\n\n            if (!nums.length) return '';\n\n            if (h.total === 'avg') {\n                return nums.reduce((a, b) => a + b, 0) / nums.length;\n            }\n\n            return nums.reduce((a, b) => a + b, 0);\n        });\n    }\n\n    createCanvas(spacer, pinnedWidth, totalWidth) {\n        spacer.style.position = 'relative';\n        const left = document.createElement('canvas');\n        const main = document.createElement('canvas');\n        const leftCtx = left.getContext('2d');\n        const mainCtx = main.getContext('2d');\n\n        left.style.position = 'absolute';\n        left.style.left = '0';\n        left.style.top = '0';\n        left.style.zIndex = '2';\n        // left.style.pointerEvents = 'none';\n\n        main.style.position = 'absolute';\n        main.style.top = '0';\n        main.style.left = pinnedWidth + 'px';\n        main.style.zIndex = '1';\n        // main.style.pointerEvents = 'none';\n        main.style.width = `${totalWidth}px`;\n\n        spacer.appendChild(left);\n        spacer.appendChild(main);\n        return {left, main, leftCtx, mainCtx};\n    }\n    // ================= DOM =================\n    setupDOM() {\n        const {\n            content, cfg, filterHost\n        } = this.state;\n\n        const totalWidth = this.sumWidths(0, this.state.colWidths.length);\n        const pinnedWidth = this.sumWidths(0, this.state.pinnedCount);\n\n        function renderFilters() {\n            if (!filterHost) {\n                return;\n            }\n            const filterPane = filterHost.querySelector('[data-name=\"FILTER\"]');\n            filterPane.addEventListener('click', event => event.stopPropagation());\n\n\n            let html = '';\n            let names = this.state.leafHeaders.map(header => header.name);\n            if (cfg.buttons && cfg.buttons.columns) {\n                Object.entries(cfg.buttons.columns).forEach(([key, cols]) => {\n                    if (key.toLowerCase() === 'all') {\n                        html += ` <input type=\"radio\" name=\"columns\" data-columns=\"${names}\" value=\"all\">${key}</a>`\n                        return;\n                    }\n                    const hidCols = names.filter(name => !cols.includes(name));\n                    html += ` <input type=\"radio\" name=\"columns\" data-columns=\"${cols}\" data-hidden_columns=\"${hidCols}\">${key}</a>`\n                });\n            }\n            filterPane.innerHTML = html;\n        }\n\n        renderFilters.call(this);\n        function createSpacer() {\n            const spacer = this.state.container.querySelector(`[data-name=\"usr-table-content\"]`) || document.createElement('div');\n\n            spacer.style.position = 'relative';\n            spacer.style.height = (this.state.totalBodyH || this.state.view.length * this.state.rowHeight) + 'px';\n            spacer.style.width = `${totalWidth}px`;\n\n            spacer.innerHTML = '';\n            const {left, main, leftCtx, mainCtx} = this.createCanvas(spacer, pinnedWidth, totalWidth);\n            this.state.leftCanvas = left;\n            this.state.mainCanvas = main;\n            this.state.leftCtx = leftCtx;\n            this.state.mainCtx = mainCtx;\n\n            this.state.spacer = spacer;\n            return spacer;\n        }\n\n        content.appendChild(createSpacer.call(this));\n\n        this.setupHeader();\n\n        function createTotals() {\n            const spacer = document.createElement('div');\n\n            spacer.style.position = 'relative';\n            spacer.style.height = this.state.rowHeight + 'px';\n            spacer.style.width = `${totalWidth}px`;\n            const {left, main, leftCtx, mainCtx} = this.createCanvas(spacer, pinnedWidth, totalWidth);\n            main.style.height = `${this.state.rowHeight}px`;\n            this.state.leftTotalCanvas = left;\n            this.state.mainTotalCanvas = main;\n            this.state.leftTotalCtx = leftCtx;\n            this.state.mainTotalCtx = mainCtx;\n\n            this.state.totalHost.style.width = '100%';\n            this.state.totalHost.replaceChildren(spacer);\n        }\n\n        createTotals.call(this);\n\n        this.resizeCanvas();\n\n        // cancelAnimationFrame pattern: always render at the latest scroll position.\n        // No manual throttle — rAF already caps at 60 fps.\n        // No isRender flag — that would silently drop events while the frame runs.\n        let _scrollRaf = null;\n        this.state.content.addEventListener('scroll', (e) => {\n            if (_scrollRaf !== null) cancelAnimationFrame(_scrollRaf);\n\n            e.preventDefault();\n            _scrollRaf = requestAnimationFrame(() => {\n                this.syncHeader();\n                this.render();\n                this._syncGroupSelect();\n                _scrollRaf = null;\n            });\n        });\n\n        this.initClick();\n    }\n\n    setupHeader() {\n        const host = this.state.headerHost;\n\n        host.innerHTML = '';\n        // host.style.position = 'sticky';\n        host.style.minWidth = '100%';\n        // host.style.top = '0';\n        host.style.zIndex = '10';\n        host.style.background = '#fff';\n        const wrap = document.createElement('div');\n        wrap.style.position = 'relative';\n        wrap.style.height = this.state.headerHeight + 'px';\n\n        const left = document.createElement('canvas');\n        const main = document.createElement('canvas');\n\n        const pinnedWidth = this.sumWidths(0, this.state.pinnedCount);\n\n        left.style.position = 'absolute';\n        left.style.left = '0';\n        left.style.top = '0';\n        left.style.zIndex = '2';\n\n        main.style.position = 'absolute';\n        main.style.left = pinnedWidth + 'px';\n        main.style.top = '0';\n\n        wrap.appendChild(left);\n        wrap.appendChild(main);\n        host.appendChild(wrap);\n\n        this.state.leftHeaderCanvas = left;\n        this.state.mainHeaderCanvas = main;\n        this.state.leftHeaderCtx = left.getContext('2d');\n        this.state.mainHeaderCtx = main.getContext('2d');\n\n        this.resizeHeaderCanvas();\n        host.addEventListener('click', (e) => {\n            const idx = this._hitTestCol(e.clientX);\n            if (idx >= 0) this._onHeaderSort(idx);\n        });\n\n        host.addEventListener('mousemove', (e) => {\n            const idx = this._hitTestCol(e.clientX);\n            if (idx !== this.state.hoverCol) {\n                this.state.hoverCol = idx;\n                this.renderHeader();\n            }\n        });\n\n        host.addEventListener('mouseleave', () => {\n            if (this.state.hoverCol !== null) {\n                this.state.hoverCol = null;\n                this.renderHeader();\n            }\n        });\n\n    }\n\n    // ── SHAPES ────────────────────────────────────────────────────────────────\n\n    drawTriangleUp(ctx, x, y, color) {\n        const size = 6 * this.state.scale;\n        this.polygon(ctx,\n            [\n            [x,        y - size],\n            [x - size, y + size],\n            [x + size, y + size]\n        ], color);\n    }\n\n    drawTriangleDown(ctx, x, y, color) {\n        const size = 6 * this.state.scale;\n        this.polygon(ctx,\n            [\n            [x,        y + size],\n            [x - size, y - size],\n            [x + size, y - size]\n        ], color);\n    }\n    polygon(ctx, points, color) {\n        ctx.save();\n        ctx.beginPath();\n        ctx.moveTo(points[0][0], points[0][1]);\n        for (let i = 1; i < points.length; i++) ctx.lineTo(points[i][0], points[i][1]);\n        ctx.closePath();\n        ctx.fillStyle   = color;\n        ctx.strokeStyle = 'rgba(0,0,0,0.4)';\n        ctx.lineWidth   = 1;\n        ctx.fill();\n        ctx.stroke();\n        ctx.restore();   // ← save/restore pair; original had restore() with no matching save()\n    }\n\n    // Sync <select> value to the topmost visible group row while scrolling.\n    _syncGroupSelect() {\n        const sel = this.state.filterHost?.querySelector('select');\n        if (!sel) return;\n\n        const { view, rowOffsets, rowHeight, content } = this.state;\n        const scrollTop = content.scrollTop;\n\n        // Last group whose top edge is at or above the current scrollTop\n        let activeOption = null;\n        for (let i = 0; i < view.length; i++) {\n            if (view[i].type !== 'group') continue;\n            const y = rowOffsets ? rowOffsets[i] : i * rowHeight;\n            if (y <= scrollTop + 1) activeOption = String(i);\n        }\n        if (activeOption !== null && sel.value !== activeOption) {\n            sel.value = activeOption;\n        }\n    }\n\n\n    resizeHeaderCanvas() {\n        const dpr = window.devicePixelRatio || 1;\n        const pinnedWidth = this.sumWidths(0, this.state.pinnedCount);\n        const width = this.state.content.clientWidth - pinnedWidth;  // viewport-sized like mainCanvas\n\n        const h = this.state.headerHeight;\n\n        // LEFT\n        this.state.leftHeaderCanvas.width = pinnedWidth * dpr;\n        this.state.leftHeaderCanvas.height = h * dpr;\n        this.state.leftHeaderCanvas.style.width = pinnedWidth + 'px';\n        this.state.leftHeaderCanvas.style.height = h + 'px';\n\n        // MAIN\n        this.state.mainHeaderCanvas.width = width * dpr;\n        this.state.mainHeaderCanvas.height = this.state.leftHeaderCanvas.height;\n        this.state.mainHeaderCanvas.style.width = `${width}px`;\n        this.state.mainHeaderCanvas.style.height = h + 'px';\n\n        this.state.leftHeaderCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n        this.state.mainHeaderCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    }\n\n    syncHeader() {\n        // Viewport-sized canvases redraw at current scrollLeft — no CSS transform needed.\n        // (translateX approach caused double-correction since draw positions already\n        //  account for scrollLeft, making header/footer scroll at 2× content speed.)\n        this.renderHeader();\n        this.renderTotal();\n    }\n\n    // ── Variable row heights for wrapped text ────────────────────────────────\n\n    static _wrapText(ctx, text, maxWidth) {\n        if (!text) return [''];\n        const str   = String(text);\n        const words = str.split(' ');\n        const lines = [];\n        let   line  = '';\n        for (const word of words) {\n            const test = line ? line + ' ' + word : word;\n            if (ctx.measureText(test).width > maxWidth && line) {\n                lines.push(line);\n                line = word;\n            } else {\n                line = test;\n            }\n        }\n        if (line) lines.push(line);\n        return lines.length ? lines : [''];\n    }\n\n    // Build rowHeights[] and rowOffsets[] from the current view.\n    // Must be called after buildView() + autoFitColumns().\n    computeRowHeights() {\n        const { view, colWidths, leafHeaders } = this.state;\n        const BASE_H    = this.state.rowHeight;   // minimum / single-line height\n        const LINE_H    = 18;                     // px per wrapped line (12px font)\n        const PAD_V     = 8;                      // vertical padding (top+bottom)\n        const FONT      = '12px sans-serif';\n\n        const ofc = document.createElement('canvas');\n        const ctx = ofc.getContext('2d');\n        ctx.font  = FONT;\n\n        const rowHeights = [];\n        view.forEach(item => {\n            if (item.type === 'group') { rowHeights.push(BASE_H); return; }\n\n            const vals = this.rowValues(item.data);\n            let maxLines = 1;\n\n            leafHeaders.forEach((h, i) => {\n                const raw = vals[i];\n                if (raw == null || raw === '') return;\n\n                // Only string/object types can wrap; numbers are single-line\n                if (typeof raw === 'number') return;\n\n                const text = typeof raw === 'object' && raw.title != null\n                    ? String(raw.title)\n                    : String(raw);\n\n                const w     = colWidths[i] - 8;  // subtract cell padding\n                const lines = JournalTable._wrapText(ctx, text, w);\n                if (lines.length > maxLines) maxLines = lines.length;\n            });\n\n            const h = Math.max(BASE_H, maxLines * LINE_H + PAD_V);\n            rowHeights.push(h);\n        });\n\n        // Cumulative offsets — rowOffsets[i] = y of row i, rowOffsets[n] = total height\n        const rowOffsets = new Float64Array(rowHeights.length + 1);\n        for (let i = 0; i < rowHeights.length; i++) {\n            rowOffsets[i + 1] = rowOffsets[i] + rowHeights[i];\n        }\n\n        this.state.rowHeights  = rowHeights;\n        this.state.rowOffsets  = rowOffsets;\n        this.state.totalBodyH  = rowOffsets[rowHeights.length];\n    }\n\n\n    // ── Sort helpers ──────────────────────────────────────────────────────\n\n    _onHeaderSort(leafIdx) {\n        const s = this.state.sortState;\n        if (s.col === leafIdx) {\n            s.dir = s.dir === 'asc' ? 'desc' : 'asc';\n        } else {\n            s.col = leafIdx;\n            s.dir = 'asc';\n        }\n        this._sortRawRows();\n        this.buildView();\n        this.render();\n        this._updateSortIndicators();\n    }\n\n    _sortRawRows() {\n        const s   = this.state.sortState;\n        if (s.col === null) return;\n        const idx = s.col;\n        const dir = s.dir === 'desc' ? -1 : 1;\n\n        const getCmp = (av, bv, d) => {\n            if (typeof av === 'number' && typeof bv === 'number') return d * (av - bv);\n            return d * String(av ?? '').localeCompare(String(bv ?? ''));\n        };\n\n        this.state.rawRows.sort((a, b) => {\n            const grpCmp = a.__group !== undefined ? getCmp(a.__group, b.__group, 1) : 0;\n            if (grpCmp !== 0) return grpCmp;\n            if (a.type === 'total') return 1;\n            if (b.type === 'total') return -1;\n            return getCmp(\n                this.rowValues(a)[idx],\n                this.rowValues(b)[idx],\n                dir\n            );\n        });\n    }\n\n    // Header is now canvas-based — redraw to reflect new sort state.\n    _updateSortIndicators() {\n        this.renderHeader();\n    }\n\n    renderTotal() {\n        const {\n            leafHeaders, rowHeight,\n            colOffsets, pinnedCount,\n            leftTotalCtx, mainTotalCtx\n        } = this.state;\n\n        if (!leftTotalCtx || !mainTotalCtx) return;\n        this.clear(leftTotalCtx, this.state.leftTotalCanvas);\n        this.clear(mainTotalCtx, this.state.mainTotalCanvas);\n\n        if (!this.state.totals) return;\n\n        // Compute visible column range fresh (don't depend on stale state.startCol/endCol)\n        const scrollLeft   = this.state.content.scrollLeft;\n        const baseOffset   = colOffsets[pinnedCount];\n        const visibleWidth = this.state.mainTotalCanvas.clientWidth;\n        const maxX         = scrollLeft + visibleWidth;\n\n        let startCol = pinnedCount;\n        while (startCol < leafHeaders.length - 1 &&\n               colOffsets[startCol + 1] - baseOffset <= scrollLeft) startCol++;\n        let endCol = startCol;\n        while (endCol < leafHeaders.length &&\n               colOffsets[endCol] - baseOffset < maxX) endCol++;\n\n        const x = colOffsets[startCol] - baseOffset - scrollLeft;\n        const item = { data: { values: ['Total', ...this.state.totals] } };\n        this.drawRow(leftTotalCtx, mainTotalCtx, startCol, endCol, item, x, 0, rowHeight);\n    }\n\n    resizeCanvas() {\n        const content = this.state.content;\n        const dpr = window.devicePixelRatio || 1;\n\n        const width = content.clientWidth;\n        const height = content.clientHeight;\n\n        const pinnedWidth = this.sumWidths(0, this.state.pinnedCount);\n\n        function setSize(ctx, width, height) {\n            ctx.width = width * dpr;\n            ctx.height = height * dpr;\n            ctx.style.width = `${width}px`;\n            ctx.style.height = `${height}px`;\n        }\n\n        // LEFT\n        setSize(this.state.leftCanvas, pinnedWidth, height);\n\n        // MAIN canvas should NOT include pinned area\n        setSize(this.state.mainCanvas, (width - pinnedWidth), height);\n\n        // TOTAL\n        setSize(this.state.mainTotalCanvas, (width - pinnedWidth), this.state.rowHeight);\n        setSize(this.state.leftTotalCanvas, width, this.state.rowHeight);\n\n        this.state.leftCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n        this.state.mainCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n        this.state.leftTotalCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n        this.state.mainTotalCtx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    }\n\n    // ================= RENDER =================\n    render() {\n        const {\n            view, rowHeight, leftCtx, leftCanvas,\n            colWidths, colOffsets, mainCtx, mainCanvas,\n            leafHeaders, pinnedCount, buffer, content\n        } = this.state;\n\n        // ── use the actual scrolling element, not the outer container ──\n        // const content = this.state.container;\n        const pinnedWidth = this.sumWidths(0, pinnedCount);\n\n        const scrollTop  = content.scrollTop;\n        const scrollLeft = content.scrollLeft;\n\n        leftCanvas.style.top = `${scrollTop}px`;\n        mainCanvas.style.top = leftCanvas.style.top;\n        // Binary-search rowOffsets for the first visible row\n        const rowOffsets  = this.state.rowOffsets;\n        const visibleBottom = scrollTop + content.clientHeight;\n\n        let startRow = 0;\n        let endRow = view.length;\n        if (rowOffsets) {\n            // find last row whose top edge <= scrollTop\n            let lo = 0, hi = view.length - 1;\n            while (lo < hi) {\n                const mid = (lo + hi + 1) >> 1;\n                if (rowOffsets[mid] <= scrollTop) lo = mid; else hi = mid - 1;\n            }\n            startRow = Math.max(0, lo );\n\n            lo = startRow;\n            hi = view.length;\n            while (lo < hi) {\n                const mid = (lo + hi) >> 1;\n                if (rowOffsets[mid] < visibleBottom) lo = mid + 1; else hi = mid;\n            }\n            endRow = Math.min(view.length, lo + buffer);\n        } else {\n            startRow = Math.max(0, Math.floor(scrollTop / rowHeight) - buffer);\n            endRow = Math.min(view.length, Math.ceil(visibleBottom / rowHeight) + buffer);\n        }\n\n        // ===== HORIZONTAL VIRTUALIZATION =====\n        // baseOffset = absolute offset where the non-pinned area begins\n        const baseOffset   = colOffsets[pinnedCount];   // == pinnedWidth\n        const visibleWidth = this.state.mainCanvas.clientWidth;\n        const maxX         = scrollLeft + visibleWidth; // visible range in non-pinned coords\n\n        let startCol = pinnedCount;\n        // advance startCol while the column is fully left of the visible area\n        while (\n            startCol < leafHeaders.length - 1 &&\n            colOffsets[startCol + 1] - baseOffset <= scrollLeft\n            ) startCol++;\n\n        let endCol = startCol;\n        while (\n            endCol < leafHeaders.length &&\n            colOffsets[endCol] - baseOffset < maxX\n            ) endCol++;\n\n        this.state.startCol = startCol;\n        this.state.endCol   = endCol;\n\n        // keep the pinned-left canvas in view as the spacer scrolls\n        leftCanvas.style.left = `${scrollLeft}px`;\n        const dpr = window.devicePixelRatio || 1;\n        // leftCtx.setTransform(dpr, 0, 0, dpr, 0, scrollTop * dpr);\n        // mainCtx.setTransform(dpr, 0, 0, dpr, scrollLeft * dpr, scrollTop * dpr);\n\n        // CLEAR\n        this.clear(mainCtx, mainCanvas);\n        this.clear(leftCtx, leftCanvas);\n\n        // ===== MAIN =====\n        const ctx = this.state.mainCtx;\n        const width = mainCanvas.width;\n\n        let lastGroup = '';\n        for (let r = startRow; r < endRow; r++) {\n            const y  = (rowOffsets ? rowOffsets[r] : r * rowHeight) - scrollTop;\n            const rh = this.state.rowHeights ? this.state.rowHeights[r] : rowHeight;\n            const item = view[r];\n            if (!item) {\n                console.log(r);\n                continue;\n            }\n\n            let x = 0;\n            if (item.type === 'group') {\n                ctx.fillStyle = '#f5f5f5';\n                ctx.fillRect(0, y, width, rh);\n                this.drawSticky(leftCtx, x, y, width, rh);\n                ctx.fillStyle = '#f5f5f5';\n                this.drawCell(leftCtx, this.groupLabel(item.key), leafHeaders[0], x, y + rh / 2);\n                lastGroup = item.key;\n                continue;\n            }\n\n            if (item.type === 'toggle-row') {\n                // Header row: blue tint, title text, +/- button.\n                // Values live in children (toggle-child rows), not in the header.\n                const pw = this.sumWidths(0, pinnedCount);\n                leftCtx.fillStyle = '#eef4ff';\n                leftCtx.fillRect(0, y, pw, rh);\n                ctx.fillStyle = '#eef4ff';\n                ctx.fillRect(0, y, width, rh);\n\n                // Title in pinned column, offset right of button\n                const title = item.data.title || '';\n                leftCtx.save();\n                leftCtx.font         = 'bold 12px sans-serif';\n                leftCtx.fillStyle    = '#334466';\n                leftCtx.textAlign    = 'left';\n                leftCtx.textBaseline = 'middle';\n                leftCtx.fillText(title, 24, y + rh / 2);\n                leftCtx.restore();\n\n                this._drawToggleButton(leftCtx, 10, y + rh / 2, item.expanded);\n                continue;\n            }\n\n            if (item.type === 'toggle-child') {\n                // Indented child row — lighter tint\n                const pw = this.sumWidths(0, pinnedCount);\n                leftCtx.fillStyle = '#f7fbff';\n                leftCtx.fillRect(0, y, pw, rh);\n                x = colOffsets[startCol] - baseOffset - scrollLeft;\n                this.drawRow(leftCtx, mainCtx, startCol, endCol, item, x, y, rh);\n                continue;\n            }\n\n            // subtract baseOffset so x=0 means left edge of the main canvas\n            x = colOffsets[startCol] - baseOffset - scrollLeft;\n            this.drawRow(leftCtx, mainCtx, startCol, endCol, item, x, y, rh);\n        }\n    }\n\n    // ── Toggle-row: +/- button, expand/collapse sub-rows ─────────────────────\n\n    // Draw a circled +/- button at canvas coordinates (x, midY)\n    _drawToggleButton(ctx, x, midY, expanded) {\n        const R = 7;\n        ctx.save();\n        ctx.fillStyle   = '#fff';\n        ctx.strokeStyle = '#5577aa';\n        ctx.lineWidth   = 1.5;\n        ctx.beginPath();\n        ctx.arc(x, midY, R, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.stroke();\n\n        ctx.strokeStyle = '#334466';\n        ctx.lineWidth   = 2;\n        ctx.beginPath();\n        ctx.moveTo(x - 4, midY);\n        ctx.lineTo(x + 4, midY);          // horizontal bar (always present)\n        if (!expanded) {\n            ctx.moveTo(x, midY - 4);\n            ctx.lineTo(x, midY + 4);      // vertical bar for '+'\n        }\n        ctx.stroke();\n        ctx.restore();\n    }\n\n    // Dispatch click on a toggle-row: collapse if open, expand if loaded,\n    // or fire htmx to load children for the first time.\n    _onToggleRowClick(viewIndex) {\n        const item = this.state.view[viewIndex];\n        if (!item || item.type !== 'toggle-row') return;\n\n        if (item.expanded) {\n            this._collapseToggleRow(viewIndex, item);\n        } else if (item.children?.length) {\n            // Children already available (pre-loaded from values or cached htmx)\n            this._expandToggleRow(viewIndex, item);\n        } else if (item.data?.link) {\n            // No children yet but a link exists — fetch from server\n            this._loadToggleRow(viewIndex, item);\n        }\n        // If no children and no link: nothing to expand\n    }\n\n    // Insert cached children after the toggle-row in view\n    _expandToggleRow(viewIndex, item) {\n        item.expanded = true;\n        this.state.view.splice(viewIndex + 1, 0, ...item.children);\n        this.computeRowHeights();\n        this.render();\n    }\n\n    // Remove children from view (keep in item.children cache for re-use)\n    _collapseToggleRow(viewIndex, item) {\n        item.expanded = false;\n        const view = this.state.view;\n        let i = viewIndex + 1;\n        while (i < view.length && view[i].type === 'toggle-child') i++;\n        view.splice(viewIndex + 1, i - viewIndex - 1);\n        this.computeRowHeights();\n        this.render();\n    }\n\n    // Fire htmx POST to data.link with data.params, parse response as child rows\n    _loadToggleRow(viewIndex, item) {\n        const data = item.data;\n        if (!data?.link) return;\n\n        const proxyId  = `_jt_toggle_${viewIndex}`;\n        const hostElem = this.state.content.children[0];\n\n        let proxy = hostElem.querySelector(`#${proxyId}`);\n        if (!proxy) {\n            proxy = document.createElement('div');\n            proxy.id = proxyId;\n            Object.assign(proxy.style, {\n                position: 'absolute',\n                left:     '-9999px',\n                width:    '1px',\n                height:   '1px',\n            });\n            hostElem.appendChild(proxy);\n\n            proxy.setAttribute('hx-post',    data.link);\n            proxy.setAttribute('hx-vals',    JSON.stringify(data.params || {}));\n            proxy.setAttribute('hx-trigger', 'load');\n            proxy.setAttribute('hx-swap',    'none');   // we insert data ourselves\n\n            proxy.addEventListener('htmx:afterRequest', (evt) => {\n                try {\n                    const resp     = JSON.parse(evt.detail.xhr.responseText);\n                    // Accept: bare array, {rows:[...]}, or {data:[...]}\n                    const rawRows  = Array.isArray(resp) ? resp : (resp.rows ?? resp.data ?? []);\n                    item.children  = rawRows.map(r => ({\n                        type: 'toggle-child',\n                        key:  item.key,\n                        data: { values: Array.isArray(r) ? r : r.values ?? r }\n                    }));\n                    this._expandToggleRow(viewIndex, item);\n                } catch (e) {\n                    console.error('toggle-row: failed to parse response', e);\n                }\n            });\n\n            if (typeof htmx !== 'undefined') htmx.process(proxy);\n        }\n\n        if (typeof htmx !== 'undefined') htmx.trigger(proxy, 'load');\n    }\n\n\n    groupLabel(key) {\n        if (typeof UnixTimetoDate === 'function' && typeof key === 'number') {\n            return UnixTimetoDate(key);\n        }\n        return key == null ? '' : String(key);\n    }\n\n\n    // rowValues normalises the two data shapes used for row cell values:\n    //   flat array  — { values: [v0, v1, ...] }\n    //   wrapped obj — { values: { values: [v0, v1, ...], __group, ... } }\n    // Always returns the inner flat array (or [] for missing/null data).\n    rowValues(data) {\n        const v = data?.values;\n        if (!v) return [];\n        return Array.isArray(v) ? v : (v.values ?? []);\n    }\n\n\n    drawRow(leftCtx, mainCtx, startCol, endCol, item, x, y, rowHeight) {\n        const {\n            leafHeaders,\n            colWidths, colOffsets, pinnedCount\n        } = this.state;\n\n        const midY = y + rowHeight / 2;\n        const vals = this.rowValues(item.data);\n\n        // ===== SCROLLABLE COLUMNS =====\n        for (let c = startCol; c < endCol; c++) {\n            const w = colWidths[c];\n            if (w === 0) continue;\n            mainCtx.strokeRect(x, y, w, rowHeight);\n            this.drawCell(mainCtx, vals[c], leafHeaders[c], x, midY, w, rowHeight);\n            x += w;\n        }\n\n        // ===== PINNED COLUMNS =====\n        x = 0;\n        for (let c = 0; c < pinnedCount; c++) {\n            const w = colWidths[c];\n            if (w === 0) continue;\n            this.drawSticky(leftCtx, x, y, w, rowHeight);\n            this.drawCell(leftCtx, vals[c], leafHeaders[c], x, midY, w, rowHeight);\n            x += w;\n        }\n    }\n\n    drawRowBackground(ctx, y, width, fill) {\n        ctx.fillStyle = fill;\n        ctx.fillRect(0, y, width, this.state.rowHeight);\n    }\n\n\n    drawSticky(ctx, x, y, w, rowHeight) {\n        ctx.fillStyle = '#fff';\n        ctx.fillRect(x, y, w, rowHeight);\n\n        ctx.strokeStyle = \"#ccc\";\n        ctx.strokeRect(x, y, w, rowHeight);\n        ctx.fillStyle = '#000';\n    }\n\n    // drawCell renders one cell value.\n    // • type:\"object\" (or header.type===\"object\") → blue underlined link text.\n    //   Click is handled in onClick via header.link / _fireLink — canvas can't\n    //   render real <a> tags, so we just style + underline.\n    // • Long text wraps within cellW, centred vertically within cellH.\n    drawCell(ctx, val, h, x, y, cellW, cellH) {\n        const obj  = this.format(ctx, val, h);\n        const text = String(obj.title ?? obj.text ?? obj ?? '');\n        if (!text) return;\n\n        const LINE_H = 18;\n        const PAD_X  = 4;\n\n        // Detect object/link cell\n        const isLink   = h?.type === 'object' || (typeof val === 'object' && val?.link);\n        const isRight  = !isLink && obj.align === 'right';\n        const isCenter = !isLink && obj.align === 'center';\n\n        if (isLink) {\n            ctx.fillStyle = '#1a6db5';\n            ctx.textAlign = 'left';\n        } else {\n            ctx.textAlign = isRight ? 'right' : isCenter ? 'center' : 'left';\n        }\n\n        const drawText = (text, drawX, drawY) => {\n            ctx.fillText(text, drawX, drawY);\n            if (isLink) {\n                // underline: measure text width and draw a 1px line below baseline\n                const tw = ctx.measureText(text).width;\n                ctx.save();\n                ctx.strokeStyle = '#1a6db5';\n                ctx.lineWidth   = 1;\n                ctx.beginPath();\n                ctx.moveTo(drawX, drawY + 5);\n                ctx.lineTo(drawX + tw, drawY + 5);\n                ctx.stroke();\n                ctx.restore();\n            }\n        };\n\n        if (cellW && ctx.measureText(text).width > cellW - PAD_X * 2) {\n            const maxW  = cellW - PAD_X * 2;\n            const lines = JournalTable._wrapText(ctx, text, maxW);\n            const totalH = lines.length * LINE_H;\n            const startY = cellH\n                ? Math.max(y - cellH / 2 + LINE_H / 2, y - totalH / 2 + LINE_H / 2)\n                : y;\n            const drawX = isRight ? x + cellW - PAD_X : x + PAD_X;\n            lines.forEach((line, i) => drawText(line, drawX, startY + i * LINE_H));\n        } else {\n            const drawX = isRight  ? x + (cellW || 0) - PAD_X\n                        : isCenter ? x + (cellW || 0) / 2\n                        : x + PAD_X;\n            drawText(text, drawX, y);\n        }\n\n        // Restore fill style for subsequent cells\n        if (isLink) ctx.fillStyle = '#000';\n    }\n\n    clear(ctx, canvas) {\n        // Reset to identity so clearRect covers the actual physical pixels,\n        // not the scroll-offset logical region (which would leave stale columns\n        // painted on the left edge when scrolling back left).\n        ctx.save();\n        ctx.setTransform(1, 0, 0, 1, 0, 0);\n        ctx.clearRect(0, 0, canvas.width, canvas.height);\n        ctx.restore();\n        ctx.font = \"12px sans-serif\";\n        ctx.textBaseline = \"middle\";\n        ctx.fillStyle = \"#000\";\n        ctx.strokeStyle = \"#ccc\";\n    }\n\n    format(ctx, value, header) {\n        if (!value) {\n            return \"\";\n        }\n\n        ctx.fillStyle = '#000';\n        try {\n            switch (typeof value) {\n                case 'number':\n                    return this.formatNumber(ctx, value, header);\n\n                case 'drange':\n                    return `${UnixTimetoDate(value[0])} - ${UnixTimetoDate(value[1])}`;\n\n                case 'photos':\n                    console.error('tmp off');\n                    return value;\n                // let el = {values: value.join(','), src: '/photos/?id=values'}\n                // const span = createPhotosSpan(name, el);\n                // cell.appendChild(span);\n                // return '';\n\n                case 'array':\n                    return value.join(',');\n\n                default:\n                    if (typeof value === 'object') {\n                        if (header.type === 'date' && typeof value?.title === 'number') {\n                            return UnixTimetoDate(value.title);\n                        }\n                        return value?.title ?? value;\n                    }\n                    return value;\n            }\n\n        } catch (e) {\n            console.error(e);\n            console.log(value);\n            return value;\n        }\n    }\n\n    formatNumber(ctx, value, header) {\n        switch (header.type) {\n            case \"money\":\n                const fmtValue = new Intl.NumberFormat(defLocales, {\n                    style: 'decimal',\n                    signDisplay: \"never\",\n                    minimumFractionDigits: 2,\n                    maximumFractionDigits: 2\n                }).format(value);\n                if (value < 0) {\n                    ctx.fillStyle = `rgb(${255 - (1000 + value) / 20}, 0, 0)`;\n                    return {text: `(${fmtValue})`, align: 'right'};\n                }\n                return {text: fmtValue, align: 'right'};\n\n            case \"float\":\n                const text = new Intl.NumberFormat(defLocales, {\n                    style: 'decimal',\n                    minimumFractionDigits: 2,\n                    maximumFractionDigits: 2\n                }).format(value);\n                return { text, align: 'right' };\n\n            case 'int':       // alias for integer\n            case 'integer':\n                return { text: value, align: 'right' };\n\n            case 'month':\n                // value is a 1-based month number — render as localised month name\n                return {\n                    text:  new Date(2000, value - 1, 1).toLocaleString(defLocales, { month: 'long' }),\n                    align: 'center'\n                };\n\n            case 'year':\n                // value is a year number — render centred\n                return { text: String(value), align: 'center' };\n\n            case 'date':\n                return UnixTimetoDate(value);\n\n            case 'datetime':\n                const curTime = new Date(value * 1000).getTime();\n                if (header.colors && header.colors.time) {\n                    ctx.fillStyle = (curTime < new Date(\"1970-01-01T\" + header.colors.time).getTime()) ? header.colors.colorBefore : header.colors.colorAfter;\n                }\n                return UnixTimetoLocal(value);\n\n            case 'time':\n                const dateTime = new Date(value * 1000).getTime();\n                if (header.colors && header.colors.time) {\n                    ctx.fillStyle = (dateTime < new Date(\"1970-01-01T\" + header.colors.time).getTime()) ? header.colors.colorBefore : header.colors.colorAfter;\n                }\n                return UnixTimetoTime(value);\n            default:\n                return value;\n        }\n    }\n\n    sumWidths(start, end) {\n        let s = 0;\n        for (let i = start; i < end; i++) s += this.state.colWidths[i];\n        return s;\n    }\n\n    // ── column hit-test ───────────────────────────────────────────────────\n    // Returns the leaf-column index for a raw clientX click on the container,\n    // or -1 if the click landed in padding / header area.\n    _hitTestCol(clientX) {\n        const { colOffsets, colWidths, pinnedCount, content, container } = this.state;\n        const pinnedWidth = this.sumWidths(0, pinnedCount);\n        const rect        = container.getBoundingClientRect();\n\n        // x in the full virtual canvas (pinned + scrolled area)\n        const xInView = clientX - rect.left;\n\n        let absX;\n        if (xInView < pinnedWidth) {\n            // clicked inside the pinned zone\n            absX = xInView;\n        } else {\n            // clicked in the scrollable zone; convert back to absolute column space\n            absX = xInView - pinnedWidth + content.scrollLeft + colOffsets[pinnedCount];\n        }\n\n        // binary-search colOffsets for the column that contains absX\n        let lo = 0, hi = colOffsets.length - 1;\n        while (lo < hi) {\n            const mid = (lo + hi + 1) >> 1;\n            if (colOffsets[mid] <= absX) lo = mid; else hi = mid - 1;\n        }\n        // verify the click lands within the column width\n        if (absX >= colOffsets[lo] && absX < colOffsets[lo] + colWidths[lo]) return lo;\n        return -1;\n    }\n\n    onClick() {\n        const {\n            leftCtx, view, container, cfg, headerHeight, content, leafHeaders, rowHeights,\n        } = this.state;\n\n        const left = container.getBoundingClientRect().left + this.sumWidths(0, this.state.pinnedCount);\n\n        container.addEventListener('click', (e) => {\n            const rect = container.getBoundingClientRect();\n\n            // ── hit-test row ──────────────────────────────────────────\n            const x = e.clientX - rect.left + content.scrollLeft;\n            let y = e.clientY - rect.top + content.scrollTop - headerHeight;\n\n            // const rowIndex = Math.round(y / rowHeight)-1;\n            // Use rowOffsets for variable-height rows; fall back to uniform height\n            const rowOffsets = this.state.rowOffsets;\n            let rowIndex;\n            if (rowOffsets) {\n                let lo = 0, hi = this.state.view.length - 1;\n                while (lo < hi) {\n                    const mid = (lo + hi + 1) >> 1;\n                    if (rowOffsets[mid] <= y) lo = mid; else hi = mid - 1;\n                }\n                rowIndex = lo;\n            } else {\n                rowIndex = Math.round(y / rowHeight) - 1;\n            }\n            // for rendering cell\n            const rowHeight = rowHeights[rowIndex];\n            y = rowOffsets[rowIndex] - content.scrollTop;\n\n            const row = this.state.view[rowIndex];\n            if (!row) return;\n\n            // Toggle button: leftmost 20px of pinned column\n            if (row.type === 'toggle-row') {\n                this._onToggleRowClick(rowIndex);\n                return;\n            }\n\n            // ── hit-test column → fire header.link if defined ─────────\n            const colIdx = this._hitTestCol(e.clientX);\n            const values = row.data?.values;\n            if (colIdx >= 0) {\n                const leafH = this.state.leafHeaders[colIdx];\n                if (leafH?.link) {\n                    const val    = values?.values[colIdx] ?? values[colIdx];\n                    const params = this._buildLinkParams(leafH, row, val);\n                    if (leafH?.isPrepend === params.id) {\n                        console.log('is prepared', params.id)\n                        return;\n                    }\n                    // compute cell's screen rect so fireLink can position its elem there\n                    // proxy is position:absolute inside the spacer → absolute canvas coords\n                    const cellRect = {\n                        left:   this.state.colOffsets[colIdx],\n                        top:    rowOffsets ? rowOffsets[rowIndex] : rowIndex * rowHeight,\n                        width:  this.state.colWidths[colIdx],\n                        height: rowHeight,\n                    };\n                    this._fireLink(leafH, params, cellRect);\n                    leafH.isPrepend = params.id;\n\n                    return;\n                }\n            }\n            if (!cfg.link) {\n                return;\n            }\n            // ── legacy trades pane (no header.link on this column) ────\n\n            // 🔥 extract values\n            const day = row.data?.__group || this.state.currentDay;\n            const symbol = values[this.colIndex('symbol')];\n            const ctx = cfg.params.ctx;\n            let dataset = {day, symbol, ctx};\n            const idxMonth = this.colIndex('month');\n            if (idxMonth > -1) {\n                const idxYear = this.colIndex('year');\n                const monthStart = new Date(values[idxYear], values[idxMonth]-1, 1);\n                const monthEnd = new Date(values[idxYear], values[idxMonth], 0);\n                dataset.calendar = `[${monthStart.toISOString().split('T')[0]},${monthEnd.toISOString().split('T')[0]}]`;\n            }\n            console.log(dataset);\n            const params = JSON.stringify(dataset);\n            const w = this.state.colWidths[0];\n            // trigger request\n            const visibleStyle = {\n                visibility: 'visible',\n                display: '',\n                left: '50%',\n            };\n            const hiddenStyle = {\n                // visibility: 'hidden',\n                display: 'none',\n                // left: '-10000px',\n                // top: '10000px',\n            };\n            const overlay = content?.overlay || content.children[0]?.overlay;\n            if (!overlay) return;\n            if (row.type !== 'row') {\n                Object.assign(overlay.style, hiddenStyle);\n                return;\n            }\n\n            overlay.values = values;\n            const trades = this.state.trades[params];\n            // hide overlay\n            if (overlay.style.display !== 'none'  && overlay.getAttribute('hx-vals') === params) {\n                this.state.activeRowIndex = null;   // no highlighted row\n                leftCtx.strokeStyle = '#000';\n                Object.assign(overlay.style, hiddenStyle);\n                leftCtx.strokeRect(0, y, w, rowHeight);\n                return;\n            } else if (overlay.getAttribute('hx-vals') !== params) {\n                // Redraw previously highlighted pinned cell in standard colour.\n                // activeRowIndex tracks which row was last highlighted red.\n                const prevIdx = this.state.activeRowIndex;\n                if (prevIdx != null && this.state.view[prevIdx]) {\n                    const prevRh  = this.state.rowHeights?.[prevIdx] ?? rowHeight;\n                    const prevY   = (this.state.rowOffsets\n                        ? this.state.rowOffsets[prevIdx]\n                        : prevIdx * rowHeight) - content.scrollTop;\n                    const prevRow = this.state.view[prevIdx];\n                    const prevVal = prevRow.data?.values?.[this.colIndex('symbol')];\n                    const symbHdr = leafHeaders[this.colIndex('symbol')];\n                    // drawSticky resets background + stroke to standard, then drawCell repaints text\n                    this.drawSticky(leftCtx, 0, prevY, w, prevRh);\n                    this.drawCell(leftCtx, prevVal, symbHdr, 0, prevY + prevRh / 2, w, prevRh);\n                }\n            }\n            this.state.activeRowIndex = rowIndex;   // remember for next click reset\n\n            overlay.style.display = '';\n\n            overlay.setAttribute('hx-vals', params);\n            const $CandlestickElement = overlay.querySelector('.Candlestick');\n\n            // setting candles\n            if ($CandlestickElement && $CandlestickElement?.getAttribute('hx-trigger') !== \"reload\") {\n                $CandlestickElement.setAttribute('hx-trigger', \"reload\");\n                $CandlestickElement.setAttribute('hx-post', $CandlestickElement.dataset[\"url\"]);\n                $CandlestickElement.setAttribute('hx-target', 'this');\n                $CandlestickElement.setAttribute('hx-swap', 'none');\n                $CandlestickElement.addEventListener(`htmx:afterSwap`, e => e.stopPropagation());\n            }\n            if (!overlay._hasEvents) {\n                overlay._hasEvents = true;\n                overlay.addEventListener(`htmx:beforeSwap`, (evt) => {\n\n                    if (!evt.detail.serverResponse) {\n                        return;\n                    }\n                    const params = overlay.getAttribute('hx-vals');\n                    let resp = JSON.parse( evt.detail.serverResponse );\n                    switch (evt.srcElement) {\n                        case $CandlestickElement:\n                            this.state.trades[params].candles = resp;\n                            return;\n\n                        case overlay:\n                            let netIdx = this.colIndex('net');\n                            let grossIdx = this.colIndex('gross');\n                            let volIdx = this.colIndex('volume');\n                            let feesIdx = this.colIndex('fees');\n                            let symbIdx = this.colIndex('symbol');\n                            let monIdx = this.colIndex('month');\n                            let yearIdx = this.colIndex('year');\n\n                            const values = overlay.values;\n\n                            const trades = {...resp,\n                                net:    netIdx > -1 ? this.formatNumber(leftCtx, values?.[netIdx], leafHeaders[netIdx]).text : null,\n                                gross:  grossIdx > -1 ? this.formatNumber(leftCtx, values?.[grossIdx], leafHeaders[grossIdx]).text : null,\n                                volume: volIdx > -1 ? this.formatNumber(leftCtx, values?.[volIdx], leafHeaders[volIdx]).text : null,\n                                fees:   feesIdx > -1 ? this.formatNumber(leftCtx, values?.[feesIdx], leafHeaders[feesIdx]).text : null,\n                                symbol: symbIdx > -1 ? this.formatNumber(leftCtx, values?.[symbIdx], leafHeaders[symbIdx]) : null,\n                                month:  monIdx > -1 ? this.formatNumber(leftCtx, values?.[monIdx], leafHeaders[monIdx]).text : null,\n                                year:   yearIdx > -1 ? this.formatNumber(leftCtx, values?.[yearIdx], leafHeaders[yearIdx]).text : null,\n                            };\n                            evt.detail.serverResponse = JSON.stringify(trades);\n                            this.state.trades[params] = { trades: trades };\n                            return;\n\n                        default:\n                            console.log(evt);\n                    }\n                });\n                overlay.addEventListener(`htmx:afterSwap`, (evt) => {\n                });\n            }\n\n            leftCtx.strokeStyle = 'red';\n            leftCtx.strokeRect(0, y, w, rowHeight);\n\n            // this.drawCell(leftCtx, symbol, leafHeaders[this.colIndex('symbol')], 0, y, colWidths[0], rowHeight);\n            // load cache data\n            if (trades) {\n                Object.assign(overlay.style, visibleStyle);\n                htmxJson.swap(overlay, trades.trades);\n                if ($CandlestickElement) {\n                    chartCandle($CandlestickElement, trades.candles, false);\n                }\n\n            } else {\n                htmx.process(overlay);\n                htmx.trigger(overlay, 'load_trades');\n\n                dataset.minutes = 5;\n                console.log(dataset);\n                if ($CandlestickElement) {\n                    // store full params\n                    $CandlestickElement.params = dataset;\n                    $CandlestickElement.setAttribute('hx-vals', `js:{\n                ...this.params\n            }`);\n                    htmx.process($CandlestickElement);\n                    htmx.trigger($CandlestickElement, 'reload');\n                }\n            }\n\n        });\n    }\n\n    // Build params object for a header.link click\n    _buildLinkParams(leafH, row, cellValue) {\n        const { cfg, leafHeaders } = this.state;\n        let params = {\n            col:   leafH.name,\n            ctx:   cfg?.params?.ctx,\n        };\n        // for journal add necessary params\n        if (cfg?.params?.day) {\n            params.day = cfg.title ? cfg.title.title : cfg.Title;\n        }\n\n        const values = row.data?.values;\n        leafHeaders.forEach((header, i) => {\n            const lowerTitle = header?.title?.toLowerCase();\n            if (header.name === cfg?.params?.[header.name]) {\n                params[header.name] = values.values?.[i] ?? values?.[i];\n            } else if (cfg.params?.[lowerTitle]) {\n                params[lowerTitle] = values.values?.[i] ?? values?.[i];\n            }\n        });\n\n        return params;\n    }\n\n    // Fire an htmx link from a header.link column click.\n    // cellRect – { left, top, width, height } in screen coords – positions\n    // the proxy elem exactly over the clicked cell so htmx targets work.\n    // Fire an htmx link from a header.link column click.\n    // \"Run once\" means: DOM creation + htmx.process() happen only on the first\n    // click (guarded by !proxy querySelector).  Every click updates hx-vals +\n    // position and calls htmx.trigger().\n    _fireLink(leafH, params, cellRect) {\n        const hxMethod = `hx-${leafH?.link_method || 'on:click'}`;\n        // Reuse or create a persistent proxy elem per link column\n        const proxyId = `_jt_link_${leafH.name}`;\n        const hostElem = this.state.content.children[0];\n        let proxy = hostElem.querySelector(`#${proxyId}`);\n        if (!proxy) {\n            proxy = document.createElement('div');\n            proxy.id = proxyId;\n            Object.assign(proxy.style, {\n                position:      'absolute',\n                zIndex:        '9999',\n                // pointerEvents: 'none',   // invisible to mouse, won't block canvas\n                overflow:      'hidden',\n                cursor: 'pointer',\n                backgroundColor: getComputedStyle(this.state.content).backgroundColor,\n            });\n            hostElem.appendChild(proxy);\n        }\n\n        // Position relative to container using cellRect (already container-relative)\n        Object.assign(proxy.style, {\n            left:  `${cellRect.left}px`,\n            top:   `${cellRect.top}px`,\n            width: `${cellRect.width}px`,\n            height:`${cellRect.height}px`,\n        });\n        proxy.setAttribute(hxMethod, leafH.link);\n        proxy.setAttribute('hx-vals', JSON.stringify(params) );\n        const trigger = leafH[\"hx-trigger\"] || 'load';\n        proxy.setAttribute('hx-trigger', trigger);\n        proxy.setAttribute('hx-target',  leafH.target || 'this');\n        if(leafH[\"hx-select\"]) {\n            proxy.setAttribute('hx-select', leafH[\"hx-select\"]);\n        }\n\n        if (leafH.target === 'self') {\n            proxy.setAttribute('hx-swap', 'json');\n            proxy.setAttribute('hx-ext', 'json-swap');\n        }\n        if (params?.id) {\n            proxy.setAttribute('data-id', params.id);\n        }\n\n        if (typeof htmx !== 'undefined') {\n            htmx.process(proxy);\n            htmx.trigger(proxy, trigger.split(' ')[0]);\n            console.log('trigger', trigger);\n        }\n        // leafH.isPrepend = true;\n    }\n\n    // Returns the screen-space left edge of column colIdx relative to container\n    _colScreenX(colIdx) {\n        const { colOffsets, pinnedCount, content, container } = this.state;\n        const pinnedWidth = this.sumWidths(0, pinnedCount);\n        const rect        = container.getBoundingClientRect();\n        if (colIdx < pinnedCount) {\n            return rect.left + colOffsets[colIdx];\n        }\n        const baseOffset = colOffsets[pinnedCount];\n        return rect.left + pinnedWidth + colOffsets[colIdx] - baseOffset - content.scrollLeft;\n    }\n\n    colIndex(name) {\n        return this.state.leafHeaders.findIndex(x => x.name === name);\n    }\n\n    initClick() {\n        const {\n            cfg,\n            container,\n            content\n        } = this.state;\n        let table = this;\n        const elem = container;\n        this.onClick();\n\n        if (!cfg.link) {\n            return\n        }\n        const hxLink = `hx-${cfg.link_method || 'post'}`;\n        elem.setAttribute(hxLink, cfg.link);\n\n        elem.setAttribute('hx-target', 'this');\n        elem.setAttribute('hx-trigger', 'load_trades');\n        elem.setAttribute('hx-ext', 'json-swap');\n        elem.setAttribute('hx-swap', 'json');\n        elem.setAttribute('hx-encoding', \"multipart/form-data\");\n        const left = elem.getBoundingClientRect().left + this.sumWidths(0, this.state.pinnedCount);\n        const showSelfChild = (evt, hxVals) => {\n            let target = evt.target;\n            Object.assign(target.style, {\n                visibility: 'visible',\n                top: '0',\n                left: `${left}px`\n                // position: 'relative'\n            });\n\n            const $CandlestickElement = target.querySelector('.Candlestick');\n            $CandlestickElement.dataset[\"minutes\"] = 5;\n            // store full params\n            $CandlestickElement.dataset.params = hxVals;\n            $CandlestickElement.setAttribute('hx-vals', `js:{\n                ...(JSON.parse(this.dataset.params)),\n                minutes: this.dataset.minutes\n            }`);\n            // let $CandlestickElement =  $('.Candlestick.instance', parent)[0];\n            $CandlestickElement.setAttribute('hx-trigger', \"load, reload\" );\n       