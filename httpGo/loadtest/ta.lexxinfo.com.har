            "compression": 14016,
            "mimeType": "text/css",
            "text": "@charset \"UTF-8\";\n:root{\n    --z-base: 0;\n    --z-dropdown: 100;\n    --z-modal: 1000;\n    --z-overlay: 10000;\n}\n\nhtml {\n    height: 100vh;\n    width: 100vw;\n    box-sizing: border-box;\n}\n\n*,\n*::before,\n*::after {\n    box-sizing: inherit;\n}\n\nbody {\n    position: absolute;\n    height: 100vh;\n    width: 100vw;\n    top: 0;\n    bottom: 0;\n    right: 0;\n    left: 0;\n    color: rgb(0, 0, 0);\n}\n\n/***** MODAL DIALOG ****/\n#modal {\n    /* Underlay covers entire screen. */\n    position: fixed;\n    top:0px;\n    bottom: 0px;\n    left:0px;\n    right:0px;\n    background-color:rgba(0,0,0,0.5);\n    z-index:1000;\n\n    /* Flexbox centers the .modal-content vertically and horizontally */\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n\n    /* Animate when opening */\n    animation-name: fadeIn;\n    animation-duration:150ms;\n    animation-timing-function: ease;\n}\n\n#modal > .modal-underlay {\n    /* underlay takes up the entire viewport. This is only\n    required if you want to click to dismiss the popup */\n    position: absolute;\n    z-index: -1;\n    top:0px;\n    bottom:0px;\n    left: 0px;\n    right: 0px;\n}\n\n#modal > .modal-content {\n    /* Position visible dialog near the top of the window */\n    margin-top:10vh;\n\n    /* Sizing for visible dialog */\n    width:80%;\n    max-width:600px;\n\n    /* Display properties for visible dialog*/\n    border:solid 1px #999;\n    border-radius:8px;\n    box-shadow: 0px 0px 20px 0px rgba(0,0,0,0.3);\n    background-color:white;\n    padding:20px;\n\n    /* Animate when opening */\n    animation-name:zoomIn;\n    animation-duration:150ms;\n    animation-timing-function: ease;\n}\n\n#modal.closing {\n    /* Animate when closing */\n    animation-name: fadeOut;\n    animation-duration:150ms;\n    animation-timing-function: ease;\n}\n\n#modal.closing > .modal-content {\n    /* Animate when closing */\n    animation-name: zoomOut;\n    animation-duration:150ms;\n    animation-timing-function: ease;\n}\n\n@keyframes fadeIn {\n    0% {opacity: 0;}\n    100% {opacity: 1;}\n}\n\n@keyframes fadeOut {\n    0% {opacity: 1;}\n    100% {opacity: 0;}\n}\n\n@keyframes zoomIn {\n    0% {transform: scale(0.9);}\n    100% {transform: scale(1);}\n}\n\n@keyframes zoomOut {\n    0% {transform: scale(1);}\n    100% {transform: scale(0.9);}\n}\nspan {\n    text-wrap: auto;\n    /*white-space: nowrap;*/\n}\n\np {\n    text-wrap: auto;\n}\n\n.dropdown span {\n    visibility: hidden;\n}\n\n.dropdown:hover span {\n    visibility: visible;\n}\n\nsvg {\n    box-sizing: content-box;\n}\n\ndiv:not(:hover) > svg .svg_interaction, svg:not(:hover) .hover_visible {\n    visibility: hidden;\n}\n\ndiv:hover > svg .svg_interaction, svg:hover .hover_visible {\n    visibility: visible;\n}\n\ndiv:not(:hover) > .hover_hidden, div:hover > .hover_visible {\n    visibility: visible;\n    opacity: 1;\n    z-index: 1000;\n}\n\ndiv:hover > .hover_hidden, div:not(:hover) > .hover_visible {\n    opacity: 0;\n    height: 0;\n    visibility: hidden;\n    z-index: -1;\n    position: absolute;\n    left: -1000px;\n}\n/*show stus messas for inputs*/\n.errorLabel {\n    display: none;\n    color: red;\n}\n\ndiv.input-wrap > input:invalid ~ .errorLabel {\n    visibility: visible;\n    color: red;\n    margin: 0;\n    display: inline-flex;\n    top: 50px;\n    z-index: 1000;\n    position: absolute;\n}\n\ndiv.input-wrap > input:placeholder-shown:focus ~ .errorLabel {\n    visibility: hidden;\n}\n\n.input-wrap > label > input[type=text], .input-wrap > label > input[type=email], .input-wrap > label > input[type=date-range] {\n    min-width: 80%;\n    text-overflow: ellipsis;\n    margin: auto;\n    transition: all 250ms;\n}\n\n.input-wrap input.form-control {\n    width: 90%;\n    height: 90%;\n    padding: 2%;\n    text-align: center;\n    border-radius: 2px;\n}\n.input-wrap input {\n    border: none;\n    background-color: initial;\n    z-index: 1000;\n}\n\n.input-wrap > label.label-text > span {\n    position: absolute;\n    display: block;\n    width: 100%;\n    height: 0;\n    top: 0;\n    left: 0;\n    pointer-events: none;\n    min-width: 100%;\n}\n\nlabel > input:placeholder-shown:focus + span::before, label > textarea:focus + span::before, label > input[value] + span::before {\n    width: 100%;\n    min-width: 100%;\n}\n\nlabel > input:placeholder-shown:focus + span::after, label > textarea[value] + span::after, label > input[value] + span::after,\nlabel > div.tox-tinymce + span::after, label > div#map + span::after {\n    top: -21px;\n}\n\nlabel > input:placeholder-shown + span::after, label > textarea:placeholder-shown + span::after {\n    top: 1px;\n    left: 0;\n    min-width: 100%;\n}\nfigure > .input-wrap > label > input:placeholder-shown:focus + span::before {\n    content: attr(data-placeholder);\n    display: block;\n    position: absolute;\n    bottom: -2px;\n    left: 0;\n    width: 0;\n    height: 2px;\n    -webkit-transition: all .4s;\n    -o-transition: all .4s;\n    -moz-transition: all .4s;\n    transition: all .4s;\n    background: #db1563;\n    background: -webkit-linear-gradient(45deg, #d5007d, #e53935);\n    background: -o-linear-gradient(45deg, #d5007d, #e53935);\n    background: -moz-linear-gradient(45deg, #d5007d, #e53935);\n    background:linear-gradient(45deg, #d5007d, #e53935)\n}\nfigure > .input-wrap > label > span::after {\n    content: attr(data-placeholder);\n    display: block;\n    width: 100%;\n    position: absolute;\n    top: 0;\n    left: 0;\n    -webkit-transition: all .4s;\n    -o-transition: all .4s;\n    -moz-transition: all .4s;\n    transition: all .4s\n}\nul.instance {\n    list-style-type: none;\n    margin: 0;\n    padding: 0;\n}\nul.instance label{\n    list-style-type: none;\n    margin: 0;\n    /*padding: 0;*/\n}\nol li {\n    display: inline-flex;\n}\nlabel > input[type=\"checkbox\"]:focus + span::before, label > input[type=\"radio\"]:focus + span::before {\n    width: 10px;\n}\n\n.input-wrap > label > input[type=\"checkbox\"], .input-wrap > label > input[type=\"radio\"] {\n    position: relative;\n    right: 15px;\n    width: auto;\n}\n\n.input-wrap > label.chk_left > input[type=checkbox] {\n    position: static;\n    top: 0;\n    left: 0;\n    margin: 0;\n    padding: 0;\n    height: 20px;\n    width: 20px;\n}\n.input-wrap > label.chk_left > input[type=checkbox] +span {\n    position: static;\n    top:-5px;\n    left: 21px;\n    min-width: calc(100% - 21px);\n    width: max-content;\n}\n.input-wrap > label.chk_left > span[data-val^=\"-\"]::after {\n    color: red;\n}\n.input-wrap > label.chk_left > span[data-val=\"0\"]::after {\n    color: red;\n}\n.input-wrap > label.chk_left > span[data-val]:not([data-val^=\"-\"]):not([data-val=\"0\"])::after {\n    color: green;\n}\n.input-wrap > label.chk_left > span::after {\n    content: attr(data-val);\n    position: absolute;\n    top: 0;\n    right: 0;\n    /*left: calc(100% - 50px);*/\n    -webkit-transition: all .4s;\n    -o-transition: all .4s;\n    -moz-transition: all .4s;\n    transition: all .4s\n}\n.input-wrap > label.input-label {\n    height: 96%;\n    width: 98%;\n    align-self: flex-start;\n    margin-top: 1%;\n    top: 0;\n    left: 0;\n    z-index: 1000;\n    position: relative;\n    padding: 2px;\n    align-content: center;\n}\n\n/* Tooltip text */\ninput + .tooltiptext {\n    visibility: hidden;\n    width: 500px !important;\n    background-color: black;\n    color: #fff;\n    text-align: center;\n    padding: 5px 0;\n    border-radius: 6px;\n\n    /* Position the tooltip text - see examples below! */\n    position: absolute;\n    top: 55px;\n    z-index: 100;\n}\n\ninput:disabled + .tooltiptext {\n    top: inherit;\n}\n\n/* Show the tooltip text when you mouse over the tooltip container */\ninput:hover + .tooltiptext {\n    visibility: visible;\n}\n\n.input-wrap > label {\n    position: relative;\n    /*width: 98%;*/\n    padding: 0;\n    align-content: center;\n    margin-top: 1px;\n}\n.input-wrap label > select {\n    align-content: flex-end;\n    text-align: center;\n    float: inline-end;\n    width: max-content;\n}\n\n.input-wrap label > input {\n    position: absolute;\n    display: block;\n    width: 100%;\n    height: 20px;\n    top: 0;\n    left: 0;\n     pointer-events: none;\n    align-content: flex-end;\n    text-align: center;\n    float: inline-end;\n}\n\noutput.htmx-settling {\n    opacity: 100;\n}\n\noutput.htmx-swap-error {\n    opacity: 100;\n    color: red;\n}\n\noutput {\n    background: #E1F0DA;\n    opacity: 0;\n    transition: opacity 3s ease-out;\n}\n/* numeric coloring */\n/* Negative money values – outlined numbers */\n:root {\n    --negative-money-color: rgb(180, 0, 0);\n    --positive-money-color: green;\n}\n.money-negative {\n    /* Safari + Chrome (true glyph stroke) */\n    -webkit-text-stroke-width: 0.6px;\n    -webkit-text-stroke-color: var(--negative-money-color);\n\n    td.money-negative {\n        -webkit-text-stroke-width: 1px;\n    }\n    /* Firefox fallback (fake outline) */\n    /*text-shadow:*/\n    /*        -0.5px -0.5px 0 var(--negative-money-color),*/\n    /*        0.5px -0.5px 0 var(--negative-money-color),*/\n    /*        -0.5px  0.5px 0 var(--negative-money-color),*/\n    /*        0.5px  0.5px 0 var(--negative-money-color);*/\n\n    /* Rendering polish */\n    font-variant-numeric: tabular-nums;\n    -webkit-font-smoothing: antialiased;\n}\n\n.money-positive {\n    /* Safari + Chrome (true glyph stroke) */\n    -webkit-text-stroke-width: 0.6px;\n    -webkit-text-stroke-color: var(--positive-money-color);\n\n    td.money-negative {\n        -webkit-text-stroke-width: 1px;\n    }\n    /* Firefox fallback (fake outline) */\n    /*text-shadow:*/\n    /*        -0.5px -0.5px 0 var(--positive-money-color),*/\n    /*        0.5px -0.5px 0 var(--positive-money-color),*/\n    /*        -0.5px  0.5px 0 var(--positive-money-color),*/\n    /*        0.5px  0.5px 0 var(--positive-money-color);*/\n\n    /* Rendering polish */\n    font-variant-numeric: tabular-nums;\n    -webkit-font-smoothing: antialiased;\n}\n\n/*active-search & table*/\nmath {\n    math-style: compact;\n}\n.filt-arrow select, .usr-table-col {\n    width: max-content;\n}\ndiv > [data-name='search-results'] {\n    /*border: 1px solid orange;*/\n    visibility: hidden;\n}\ndiv:focus-within > [data-name='search-results'], div:hover > [data-name='search-results'] {\n    border: 1px solid orange;\n    visibility: visible;\n    z-index: 1000 !important;\n}\nul[data-name='search-results'] li:focus {\n    background-color: #d0e6ff;\n    outline: 1px solid #4a90e2;\n}\nol[data-name=\"ol_selected\"] {\n    /*display: flex;*/\n    /*flex-grow: 1;*/\n    /*width: -webkit-fill-available;*/\n    margin: 0;\n    padding: 0;\n}\n[data-name=\"ol_selected\"] li {\n    width: fit-content;\n    outline: 1px solid #4a90e2;\n    border-radius: 5%;\n    height: 80%;\n    cursor: crosshair;\n}\n/*[data-name=\"ol_selected\"] li > span {*/\n/*    width: 0;*/\n/*    height: 0;*/\n/*    visibility: hidden;*/\n/*    max-width: 0;*/\n/*}*/\n/* indication progress */\n.progress {\n    position: fixed;\n    top: 0;\n    z-index: 1000;\n    height: 4px;\n    width: 100%;\n    border-radius: 2px;\n    background-clip: padding-box;\n    overflow: hidden;\n}\n.progress .indeterminate:before {\n    content: \"\";\n    position: absolute;\n    background-color: inherit;\n    top: 0;\n    left: 0;\n    bottom: 0;\n    will-change: left, right;\n    -webkit-animation: indeterminate 2.1s cubic-bezier(0.65, 0.815, 0.735, 0.395)\n    infinite;\n    animation: indeterminate 2.1s cubic-bezier(0.65, 0.815, 0.735, 0.395) infinite;\n}\n.progress .indeterminate:after {\n    content: \"\";\n    position: absolute;\n    background-color: inherit;\n    top: 0;\n    left: 0;\n    bottom: 0;\n    will-change: left, right;\n    -webkit-animation: indeterminate-short 2.1s cubic-bezier(0.165, 0.84, 0.44, 1)\n    infinite;\n    animation: indeterminate-short 2.1s cubic-bezier(0.165, 0.84, 0.44, 1)\n    infinite;\n    -webkit-animation-delay: 1.15s;\n    animation-delay: 1.15s;\n}\n.progress {\n    display: none;\n}\n.htmx-request .progress {\n    display: inline;\n}\n.htmx-request.progress {\n    display: inline;\n}\n@-webkit-keyframes indeterminate {\n    0% {\n        left: -35%;\n        right: 100%;\n    }\n    60% {\n        left: 100%;\n        right: -90%;\n    }\n    100% {\n        left: 100%;\n        right: -90%;\n    }\n}\n@keyframes indeterminate {\n    0% {\n        left: -35%;\n        right: 100%;\n    }\n    60% {\n        left: 100%;\n        right: -90%;\n    }\n    100% {\n        left: 100%;\n        right: -90%;\n    }\n}\n@-webkit-keyframes indeterminate-short {\n    0% {\n        left: -200%;\n        right: 100%;\n    }\n    60% {\n        left: 107%;\n        right: -8%;\n    }\n    100% {\n        left: 107%;\n        right: -8%;\n    }\n}\n@keyframes indeterminate-short {\n    0% {\n        left: -200%;\n        right: 100%;\n    }\n    60% {\n        left: 107%;\n        right: -8%;\n    }\n    100% {\n        left: 107%;\n        right: -8%;\n    }\n}\n/* Dropdowns support */\n:root {\n    --bg: #fff;\n    --muted: #777;\n    --border: #d1d5db;\n    --accent: #2563eb;\n    --radius: 8px;\n    --shadow: 0 4px 12px rgba(0,0,0,.08);\n    font-family: system-ui, sans-serif;\n}\n.noselect {\n    -webkit-user-select: none; /* Safari / old iOS */\n    user-select: none;         /* Modern browsers */\n}\n\ndetails {\n    position: relative;\n    display: inline-block;\n    -webkit-user-select: none; /* Safari / old iOS */\n    user-select: none;\n}\n\n/* Summary acts like control */\ndetails summary {\n    list-style: none;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: .5rem;\n    box-shadow: none;\n    transition: border-color .12s ease, box-shadow .12s ease;\n}\ndetails summary::after {\n    content: \"\";\n    border: solid currentColor;\n    border-width: 0 1.5px 1.5px 0;\n    display: inline-block;\n    padding: 3px;\n    transform: rotate(45deg);\n    opacity: .8;\n}\ndetails[open] summary::after {\n    transform: rotate(-135deg);\n    margin-top: 3px;\n}\ndetails summary:focus {\n    outline: none;\n    border-color: var(--accent);\n    box-shadow: 0 0 0 4px rgba(37,99,235,0.15);\n}\n\n/* Hide the default marker in Firefox */\ndetails summary::-webkit-details-marker {\n    display: none;\n}\n\n/* Dropdown menu */\ndetails > ul > li {\n    overflow-y: auto;\n    z-index: 10;\n    opacity: 0;\n    pointer-events: none;\n    transform: translateY(-6px);\n    transition: opacity .12s ease, transform .12s ease;\n}\n\n/* Show when open */\ndetails[open] > ul > li {\n    opacity: 1;\n    pointer-events: auto;\n    transform: translateY(0);\n}\n\n/* Options */\ndetails label{\n    display: flex;\n    align-items: center;\n    padding: .5rem .75rem;\n    cursor: pointer;\n    border-radius: 6px;\n    gap: .5rem;\n    color: #111827;\n}\ndetails label:hover {\n    background: rgba(37,99,235,0.06);\n}\ndetails label > input[type=\"radio\"] {\n    accent-color: var(--accent);\n}\n\n/* Optional: selected item visual */\ndetails label > input[type=\"radio\"]:checked + span,\ndetails label > input[type=\"radio\"]:checked {\n    font-weight: 600;\n    color: var(--accent);\n}\n\n.hidden {\n    display: none;\n    visibility: hidden;\n}\n\n/* files shwing */\nform span.hiddenInput {\n    position: relative;\n    border: 1px solid #ccc;\n    width: 100%;\n    height: 100%;\n    min-height: 50px;\n    display: inline-block;\n    overflow: hidden;\n    cursor: pointer;\n    /*for the background, optional*/\n    background: center center no-repeat scroll;\n    background-size: 75% 75%;\n    background-image: url(data:image/svg+xml;utf8;base64,)\n}\n\nform .hiddenInput > input[type=file][value] {\n    opacity: 10%;\n}\n\nform .hiddenInput > input[type=file], .hiddenInputFile > input[type=file] {\n    width: 100%;\n    height: 100%;\n    opacity: 0;\n    cursor: pointer;\n}\n\n/* for images as preview*/\nspan.hiddenInput.img:hover {\n    position: fixed;\n    top: 1%;\n    right: 1%;\n    width: 25%;\n    max-height: 75%;\n}\n\n/* Google chart impovements */\n.crosshair-layer {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    z-index: 10;\n}\n\n.vLine {\n    position: absolute;\n    top: 0;\n    bottom: 0;\n    background: rgba(120,120,120,0.2);\n}\n\n.hLine {\n    position: absolute;\n    left: 0;\n    right: 0;\n    height: 1px;\n    background: rgba(120,120,120,0.6);\n}\n\n.tooltip {\n    position: absolute;\n    background: #111;\n    color: #fff;\n    padding: 6px 8px;\n    font-size: 12px;\n    border-radius: 4px;\n    white-space: nowrap;\n}\n\n\n.price-label { position:absolute; right:0; background:#222; color:#fff; padding:2px 4px; }"
