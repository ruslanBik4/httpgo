          "content": {
            "size": 27584,
            "compression": -18,
            "mimeType": "application/json",
            "text": "\n/*\n * transition.js\n *\n * Runtime for Figma Prototype transitions.\n *\n * Primary engine:\n *   - CSS transitions\n *   - Web Animations API\n *\n * Secondary engine:\n *   - Anime.js (loaded lazily only when required)\n */\n\n  class Transition {\n\n    //--------------------------------------------------------------------------\n    // configuration\n    //--------------------------------------------------------------------------\n\n    static AnimeURL =\n        \"https://cdn.jsdelivr.net/npm/animejs@4.1.3/lib/anime.iife.min.js\";\n\n    static animePromise = null;\n\n    static DefaultDuration = 300;\n\n    //--------------------------------------------------------------------------\n    // anime loader\n    //--------------------------------------------------------------------------\n\n    static async ensureAnime() {\n\n        if (window.anime)\n            return window.anime;\n\n        if (Transition.animePromise)\n            return Transition.animePromise;\n\n        Transition.animePromise = new Promise((resolve, reject) => {\n\n            const script = document.createElement(\"script\");\n\n            script.src = Transition.AnimeURL;\n            script.async = true;\n\n            script.onload = () => resolve(window.anime);\n\n            script.onerror = reject;\n\n            document.head.appendChild(script);\n        });\n\n        return Transition.animePromise;\n    }\n\n    //--------------------------------------------------------------------------\n    // parsing\n    //--------------------------------------------------------------------------\n\n    static parseTime(value) {\n\n        if (!value)\n            return 0;\n\n        value = value.trim();\n\n        if (value.endsWith(\"ms\"))\n            return parseFloat(value);\n\n        if (value.endsWith(\"s\"))\n            return parseFloat(value) * 1000;\n\n        return parseFloat(value);\n    }\n\n    static css(el) {\n\n        return getComputedStyle(el);\n    }\n\n    static transitionInfo(el) {\n\n        const css = Transition.css(el);\n\n        return {\n\n            type:\n                el.dataset.transition ??\n                \"instant\",\n\n            direction:\n                el.dataset.direction ??\n                \"left\",\n\n            duration:\n                Transition.parseTime(css.transitionDuration) ||\n                Number(el.dataset.duration) ||\n                Transition.DefaultDuration,\n\n            delay:\n                Transition.parseTime(css.transitionDelay),\n\n            easing:\n                css.transitionTimingFunction ||\n                el.dataset.timingFunction ||\n                \"ease\",\n\n            property:\n            css.transitionProperty,\n\n            opacity:\n            css.opacity,\n\n            transform:\n            css.transform,\n\n            visibility:\n            css.visibility,\n\n            display:\n            css.display,\n\n            matchLayers:\n                el.dataset.matchLayers === \"true\",\n\n            preserveScroll:\n                el.dataset.preserveScroll === \"true\"\n\n        };\n\n    }\n\n    //--------------------------------------------------------------------------\n    // promises\n    //--------------------------------------------------------------------------\n\n    static nextFrame() {\n\n        return new Promise(resolve =>\n            requestAnimationFrame(resolve)\n        );\n\n    }\n\n    static wait(ms) {\n\n        return new Promise(resolve =>\n            setTimeout(resolve, ms)\n        );\n\n    }\n\n    static waitTransition(el, info) {\n\n        return new Promise(resolve => {\n\n            let done = false;\n\n            const finish = () => {\n\n                if (done)\n                    return;\n\n                done = true;\n\n                el.removeEventListener(\n                    \"transitionend\",\n                    transitionEnd\n                );\n\n                resolve();\n            };\n\n            const transitionEnd = e => {\n\n                if (e.target !== el)\n                    return;\n\n                finish();\n\n            };\n\n            el.addEventListener(\n                \"transitionend\",\n                transitionEnd\n            );\n\n            setTimeout(\n                finish,\n                info.duration + info.delay + 50\n            );\n\n        });\n\n    }\n\n    static waitAnimation(animation) {\n\n        if (!animation)\n            return Promise.resolve();\n\n        return animation.finished.catch(() => {});\n\n    }\n\n    //--------------------------------------------------------------------------\n    // css helpers\n    //--------------------------------------------------------------------------\n\n    static setVisible(el) {\n\n        el.hidden = false;\n\n        el.style.display = \"\";\n\n        el.style.visibility = \"visible\";\n\n    }\n\n    static setHidden(el) {\n\n        el.style.visibility = \"hidden\";\n\n        el.hidden = true;\n\n    }\n\n    static saveInlineStyle(el) {\n\n        return {\n\n            transform: el.style.transform,\n            opacity: el.style.opacity,\n            display: el.style.display,\n            visibility: el.style.visibility\n\n        };\n\n    }\n\n    static restoreInlineStyle(el, state) {\n\n        el.style.transform =\n            state.transform;\n\n        el.style.opacity =\n            state.opacity;\n\n        el.style.display =\n            state.display;\n\n        el.style.visibility =\n            state.visibility;\n\n    }\n\n    //--------------------------------------------------------------------------\n    // transform helpers\n    //--------------------------------------------------------------------------\n\n    static translate(direction) {\n\n        switch (direction) {\n\n            case \"left\":\n                return \"translateX(-100%)\";\n\n            case \"right\":\n                return \"translateX(100%)\";\n\n            case \"top\":\n                return \"translateY(-100%)\";\n\n            case \"bottom\":\n                return \"translateY(100%)\";\n\n            default:\n                return \"translateX(0)\";\n        }\n\n    }\n\n    static opposite(direction) {\n\n        switch (direction) {\n\n            case \"left\":\n                return \"right\";\n\n            case \"right\":\n                return \"left\";\n\n            case \"top\":\n                return \"bottom\";\n\n            case \"bottom\":\n                return \"top\";\n\n            default:\n                return direction;\n\n        }\n\n    }\n\n    //--------------------------------------------------------------------------\n    // animation dispatcher\n    //--------------------------------------------------------------------------\n\n    static async show(el) {\n\n        return Transition.animateIn(el);\n\n    }\n\n    static async hide(el) {\n\n        return Transition.animateOut(el);\n\n    }\n\n\n     //------------------------------------------------------------------------------\n// animation dispatchers\n//------------------------------------------------------------------------------\n\n     static async animateIn(el) {\n\n         const t = Transition.transitionInfo(el);\n\n         switch (t.type.toLowerCase()) {\n\n             case \"instant\":\n                 return Transition.instantIn(el);\n\n             case \"dissolve\":\n                 return Transition.dissolveIn(el, t);\n\n             case \"move-in\":\n                 return Transition.moveIn(el, t);\n\n             case \"move_out\":\n             case \"move-out\":\n                 return Transition.moveOut(el, t);\n\n             case \"slide-in\":\n                 return Transition.slideIn(el, t);\n\n             case \"slide-out\":\n                 return Transition.slideOut(el, t);\n\n             case \"push\":\n             case \"smart-animate\":\n                 await Transition.ensureAnime();\n                 return Transition.animeIn(el, t);\n\n             default:\n                 return Transition.instantIn(el);\n         }\n\n     }\n\n     static async animateOut(el) {\n\n         const t = Transition.transitionInfo(el);\n\n         switch (t.type.toLowerCase()) {\n\n             case \"instant\":\n                 return Transition.instantOut(el);\n\n             case \"dissolve\":\n                 return Transition.dissolveOut(el, t);\n\n             case \"move-in\":\n                 return Transition.moveInReverse(el, t);\n\n             case \"move_out\":\n             case \"move-out\":\n                 return Transition.moveOutReverse(el, t);\n\n             case \"slide-in\":\n                 return Transition.slideInReverse(el, t);\n\n             case \"slide-out\":\n                 return Transition.slideOutReverse(el, t);\n\n             case \"push\":\n             case \"smart-animate\":\n                 await Transition.ensureAnime();\n                 return Transition.animeOut(el, t);\n\n             default:\n                 return Transition.instantOut(el);\n         }\n\n     }\n\n//------------------------------------------------------------------------------\n// CSS transition engine\n//------------------------------------------------------------------------------\n\n     static async cssTransition(el, prepare) {\n\n         const t = Transition.transitionInfo(el);\n\n         const save = Transition.saveInlineStyle(el);\n\n         Transition.setVisible(el);\n\n         prepare(el);\n\n         await Transition.nextFrame();\n\n         el.style.transitionProperty =\n             \"transform,opacity\";\n\n         el.style.transitionDuration =\n             `${t.duration}ms`;\n\n         el.style.transitionTimingFunction =\n             t.easing;\n\n         el.style.transitionDelay =\n             `${t.delay}ms`;\n\n         await Transition.nextFrame();\n\n         el.classList.add(\"__transition-running\");\n\n         prepare.finish(el);\n\n         await Transition.waitTransition(el, t);\n\n         el.classList.remove(\"__transition-running\");\n\n         el.style.transitionProperty = \"\";\n         el.style.transitionDuration = \"\";\n         el.style.transitionTimingFunction = \"\";\n         el.style.transitionDelay = \"\";\n\n         Transition.restoreInlineStyle(el, save);\n\n     }\n\n//------------------------------------------------------------------------------\n// Web Animations API\n//------------------------------------------------------------------------------\n\n     static async waapi(el, keyframes, t) {\n\n         if (!el.animate)\n             return;\n\n         const animation = el.animate(\n             keyframes,\n             {\n                 duration: t.duration,\n                 delay: t.delay,\n                 easing: t.easing,\n                 fill: \"both\"\n             }\n         );\n\n         return Transition.waitAnimation(animation);\n\n     }\n\n//------------------------------------------------------------------------------\n// Anime.js wrappers\n//------------------------------------------------------------------------------\n\n     static async animeIn(el, t) {\n\n         return anime({\n\n             targets: el,\n\n             opacity: [0, 1],\n\n             duration: t.duration,\n\n             easing: t.easing\n\n         }).finished;\n\n     }\n\n     static async animeOut(el, t) {\n\n         return anime({\n\n             targets: el,\n\n             opacity: [1, 0],\n\n             duration: t.duration,\n\n             easing: t.easing\n\n         }).finished;\n\n     }\n\n//------------------------------------------------------------------------------\n// helpers\n//------------------------------------------------------------------------------\n\n     static offscreen(direction) {\n\n         switch (direction) {\n\n             case \"left\":\n                 return {\n                     x: \"-100%\",\n                     y: \"0%\"\n                 };\n\n             case \"right\":\n                 return {\n                     x: \"100%\",\n                     y: \"0%\"\n                 };\n\n             case \"top\":\n                 return {\n                     x: \"0%\",\n                     y: \"-100%\"\n                 };\n\n             case \"bottom\":\n                 return {\n                     x: \"0%\",\n                     y: \"100%\"\n                 };\n\n             default:\n                 return {\n                     x: \"0%\",\n                     y: \"0%\"\n                 };\n\n         }\n\n     }\n\n     static oppositeOffset(direction) {\n\n         return Transition.offscreen(\n             Transition.opposite(direction)\n         );\n\n     }\n\n     static transform(x, y) {\n\n         return `translate(${x}, ${y})`;\n\n     }\n\n     //------------------------------------------------------------------------------\n// INSTANT\n//------------------------------------------------------------------------------\n\n     static async instantIn(el) {\n\n         Transition.setVisible(el);\n\n     }\n\n     static async instantOut(el) {\n\n         Transition.setHidden(el);\n\n     }\n\n//------------------------------------------------------------------------------\n// DISSOLVE\n//------------------------------------------------------------------------------\n\n     static async dissolveIn(el, t) {\n\n         if (el.animate) {\n\n             return Transition.waapi(el, [\n                 { opacity: 0 },\n                 { opacity: 1 }\n             ], t);\n\n         }\n\n         return Transition.cssTransition(el, Object.assign(\n\n             e => {\n                 e.style.opacity = \"0\";\n             },\n\n             {\n                 finish(e) {\n                     e.style.opacity = \"1\";\n                 }\n             }\n\n         ));\n\n     }\n\n     static async dissolveOut(el, t) {\n\n         if (el.animate) {\n\n             await Transition.waapi(el, [\n                 { opacity: 1 },\n                 { opacity: 0 }\n             ], t);\n\n             Transition.setHidden(el);\n\n             return;\n         }\n\n         await Transition.cssTransition(el, Object.assign(\n\n             e => {\n                 e.style.opacity = \"1\";\n             },\n\n             {\n                 finish(e) {\n                     e.style.opacity = \"0\";\n                 }\n             }\n\n         ));\n\n         Transition.setHidden(el);\n\n     }\n\n//------------------------------------------------------------------------------\n// MOVE IN\n//------------------------------------------------------------------------------\n\n     static async moveIn(el, t) {\n\n         const p = Transition.offscreen(t.direction);\n\n         if (el.animate) {\n\n             return Transition.waapi(el, [\n\n                 {\n                     transform: Transition.transform(p.x, p.y)\n                 },\n\n                 {\n                     transform: \"translate(0%,0%)\"\n                 }\n\n             ], t);\n\n         }\n\n         return Transition.cssTransition(el, Object.assign(\n\n             e => {\n                 e.style.transform =\n                     Transition.transform(p.x, p.y);\n             },\n\n             {\n                 finish(e) {\n                     e.style.transform = \"\";\n                 }\n             }\n\n         ));\n\n     }\n\n//------------------------------------------------------------------------------\n// MOVE OUT\n//------------------------------------------------------------------------------\n\n     static async moveOut(el, t) {\n\n         const p = Transition.offscreen(t.direction);\n\n         if (el.animate) {\n\n             await Transition.waapi(el, [\n\n                 {\n                     transform: \"translate(0%,0%)\"\n                 },\n\n                 {\n                     transform: Transition.transform(p.x, p.y)\n                 }\n\n             ], t);\n\n             Transition.setHidden(el);\n\n             return;\n         }\n\n         await Transition.cssTransition(el, Object.assign(\n\n             e => {\n                 e.style.transform = \"\";\n             },\n\n             {\n                 finish(e) {\n\n                     e.style.transform =\n                         Transition.transform(p.x, p.y);\n\n                 }\n             }\n\n         ));\n\n         Transition.setHidden(el);\n\n     }\n\n//------------------------------------------------------------------------------\n// reverse variants\n//------------------------------------------------------------------------------\n\n     static async moveInReverse(el, t) {\n\n         return Transition.moveOut(el, {\n             ...t,\n             direction: Transition.opposite(t.direction)\n         });\n\n     }\n\n     static async moveOutReverse(el, t) {\n\n         return Transition.moveIn(el, {\n             ...t,\n             direction: Transition.opposite(t.direction)\n         });\n\n     }\n\n//------------------------------------------------------------------------------\n// SLIDE IN\n//------------------------------------------------------------------------------\n\n     static async slideIn(el, t) {\n\n         return Transition.moveIn(el, t);\n\n     }\n\n//------------------------------------------------------------------------------\n// SLIDE OUT\n//------------------------------------------------------------------------------\n\n     static async slideOut(el, t) {\n\n         return Transition.moveOut(el, t);\n\n     }\n\n//------------------------------------------------------------------------------\n// reverse slide\n//------------------------------------------------------------------------------\n\n     static async slideInReverse(el, t) {\n\n         return Transition.moveOut(el, {\n             ...t,\n             direction: Transition.opposite(t.direction)\n         });\n\n     }\n\n     static async slideOutReverse(el, t) {\n\n         return Transition.moveIn(el, {\n             ...t,\n             direction: Transition.opposite(t.direction)\n         });\n\n     }\n\n     //------------------------------------------------------------------------------\n// PUSH\n//\n// Both old and new elements move simultaneously.\n//------------------------------------------------------------------------------\n\n     static async push(oldEl, newEl) {\n\n         const t = Transition.transitionInfo(newEl);\n\n         const off = Transition.offscreen(t.direction);\n         const out = Transition.oppositeOffset(t.direction);\n\n         Transition.setVisible(newEl);\n\n         // Insert before old element so both exist simultaneously.\n         oldEl.parentNode.insertBefore(newEl, oldEl.nextSibling);\n\n         if (oldEl.animate && newEl.animate) {\n\n             const a1 = oldEl.animate([\n                 {\n                     transform: \"translate(0%,0%)\"\n                 },\n                 {\n                     transform: Transition.transform(out.x, out.y)\n                 }\n             ], {\n                 duration: t.duration,\n                 delay: t.delay,\n                 easing: t.easing,\n                 fill: \"forwards\"\n             });\n\n             const a2 = newEl.animate([\n                 {\n                     transform: Transition.transform(off.x, off.y)\n                 },\n                 {\n                     transform: \"translate(0%,0%)\"\n                 }\n             ], {\n                 duration: t.duration,\n                 delay: t.delay,\n                 easing: t.easing,\n                 fill: \"forwards\"\n             });\n\n             await Promise.all([\n                 Transition.waitAnimation(a1),\n                 Transition.waitAnimation(a2)\n             ]);\n\n         } else {\n\n             newEl.style.transform =\n                 Transition.transform(off.x, off.y);\n\n             await Transition.nextFrame();\n\n             oldEl.style.transition =\n                 newEl.style.transition =\n                     `transform ${t.duration}ms ${t.easing}`;\n\n             oldEl.style.transform =\n                 Transition.transform(out.x, out.y);\n\n             newEl.style.transform = \"\";\n\n             await Transition.wait(t.duration);\n\n         }\n\n         oldEl.remove();\n\n     }\n\n//------------------------------------------------------------------------------\n// OVERLAY\n//------------------------------------------------------------------------------\n\n     static async overlay(parent, overlay) {\n\n         const t = Transition.transitionInfo(overlay);\n\n         if (!overlay.parentNode)\n             parent.appendChild(overlay);\n\n         overlay.style.position = \"absolute\";\n\n         overlay.style.left ??= \"0\";\n         overlay.style.top ??= \"0\";\n\n         await Transition.animateIn(overlay);\n\n     }\n\n//------------------------------------------------------------------------------\n// CLOSE OVERLAY\n//------------------------------------------------------------------------------\n\n     static async closeOverlay(overlay) {\n\n         await Transition.animateOut(overlay);\n\n         overlay.remove();\n\n     }\n\n//------------------------------------------------------------------------------\n// SWAP\n//\n// Replace without removing until animation completes.\n//------------------------------------------------------------------------------\n\n     static async swap(oldEl, newEl) {\n\n         const t = Transition.transitionInfo(newEl);\n\n         oldEl.parentNode.insertBefore(\n             newEl,\n             oldEl.nextSibling\n         );\n\n         newEl.style.position = \"absolute\";\n         newEl.style.left = \"0\";\n         newEl.style.top = \"0\";\n         newEl.style.width = \"100%\";\n         newEl.style.height = \"100%\";\n\n         await Promise.all([\n             Transition.dissolveOut(oldEl, t),\n             Transition.dissolveIn(newEl, t)\n         ]);\n\n         oldEl.remove();\n\n         newEl.style.position = \"\";\n         newEl.style.left = \"\";\n         newEl.style.top = \"\";\n         newEl.style.width = \"\";\n         newEl.style.height = \"\";\n\n     }\n\n//------------------------------------------------------------------------------\n// Dispatcher extension.\n//\n// Replace play() from Part 1 with this implementation.\n//------------------------------------------------------------------------------\n\n     static async play(oldElement, newElement, succesful) {\n\n         if (!oldElement) {\n             await Transition.show(newElement);\n             return;\n         }\n\n         const t = Transition.transitionInfo(newElement);\n\n         switch (t.type.toLowerCase()) {\n\n             case \"push\":\n                  Transition.push(oldElement, newElement);\n\n             case \"overlay\":\n                  Transition.overlay(\n                     oldElement.parentNode,\n                     newElement\n                 );\n\n             case \"swap\":\n                  Transition.swap(\n                     oldElement,\n                     newElement\n                 );\n\n             default:\n\n                 await Transition.animateOut(oldElement);\n\n                 oldElement.replaceWith(newElement);\n\n                 await Transition.animateIn(newElement);\n\n         }\n         succesful();\n\n     }\n     //------------------------------------------------------------------------------\n// DOM\n//------------------------------------------------------------------------------\n\n     static rect(el) {\n         return el.getBoundingClientRect();\n     }\n\n     static cloneRect(r) {\n         return {\n             left: r.left,\n             top: r.top,\n             width: r.width,\n             height: r.height,\n             right: r.right,\n             bottom: r.bottom\n         };\n     }\n\n     static reflow(el) {\n         void el.offsetWidth;\n     }\n\n     static nextTick() {\n         return Promise.resolve();\n     }\n\n     static raf() {\n         return new Promise(resolve =>\n             requestAnimationFrame(resolve)\n         );\n     }\n\n     static raf2() {\n         return Transition.raf().then(() => Transition.raf());\n     }\n\n//------------------------------------------------------------------------------\n// Scroll\n//------------------------------------------------------------------------------\n\n     static saveScroll(el) {\n\n         return {\n             left: el.scrollLeft,\n             top: el.scrollTop\n         };\n\n     }\n\n     static restoreScroll(el, scroll) {\n\n         if (!scroll)\n             return;\n\n         el.scrollLeft = scroll.left;\n         el.scrollTop = scroll.top;\n\n     }\n\n//------------------------------------------------------------------------------\n// Focus\n//------------------------------------------------------------------------------\n\n     static saveFocus() {\n         return document.activeElement;\n     }\n\n     static restoreFocus(el) {\n\n         if (!el)\n             return;\n\n         try {\n             el.focus({\n                 preventScroll: true\n             });\n         } catch (_) {}\n\n     }\n\n//------------------------------------------------------------------------------\n// Dataset\n//------------------------------------------------------------------------------\n\n     static bool(value) {\n\n         return value === true ||\n             value === \"true\" ||\n             value === \"1\";\n\n     }\n\n     static number(value, def = 0) {\n\n         const n = Number(value);\n\n         return Number.isFinite(n)\n             ? n\n             : def;\n\n     }\n\n//------------------------------------------------------------------------------\n// Style\n//------------------------------------------------------------------------------\n\n     static clearTransition(el) {\n\n         el.style.transitionProperty = \"\";\n         el.style.transitionDuration = \"\";\n         el.style.transitionDelay = \"\";\n         el.style.transitionTimingFunction = \"\";\n\n     }\n\n     static clearTransform(el) {\n\n         el.style.transform = \"\";\n\n     }\n\n     static clearOpacity(el) {\n\n         el.style.opacity = \"\";\n\n     }\n\n     static reset(el) {\n\n         Transition.clearTransition(el);\n         Transition.clearTransform(el);\n         Transition.clearOpacity(el);\n\n     }\n\n//------------------------------------------------------------------------------\n// Visibility\n//------------------------------------------------------------------------------\n\n     static showElement(el) {\n\n         el.hidden = false;\n         el.style.display = \"\";\n         el.style.visibility = \"visible\";\n\n     }\n\n     static hideElement(el) {\n\n         el.hidden = true;\n         el.style.visibility = \"hidden\";\n\n     }\n\n     static remove(el) {\n\n         if (el && el.parentNode)\n             el.parentNode.removeChild(el);\n\n     }\n\n//------------------------------------------------------------------------------\n// Events\n//------------------------------------------------------------------------------\n\n     static dispatch(el, name, detail = {}) {\n\n         el.dispatchEvent(\n             new CustomEvent(name, {\n                 bubbles: true,\n                 detail\n             })\n         );\n\n     }\n\n//------------------------------------------------------------------------------\n// HTMX\n//------------------------------------------------------------------------------\n\n     static processHTMX(el) {\n\n         if (window.htmx)\n             htmx.process(el);\n\n     }\n\n     static triggerHTMX(el, event = \"on_change\") {\n\n         if (window.htmx)\n             htmx.trigger(el, event);\n\n     }\n\n//------------------------------------------------------------------------------\n// Transition cleanup\n//------------------------------------------------------------------------------\n\n     static finish(oldEl, newEl) {\n\n         if (oldEl)\n             Transition.remove(oldEl);\n\n         if (newEl) {\n\n             Transition.reset(newEl);\n\n             Transition.processHTMX(newEl);\n\n             Transition.triggerHTMX(newEl);\n\n             newEl.querySelector(\n                 \"input,textarea,select,[tabindex]\"\n             )?.focus();\n\n         }\n\n     }\n\n//------------------------------------------------------------------------------\n// Debug\n//------------------------------------------------------------------------------\n\n     static debug(...args) {\n\n         if (!Transition.DEBUG)\n             return;\n\n         console.log(\"[Transition]\", ...args);\n\n     }\n\n     static DEBUG = false;\n}\n\nwindow.Transition = Transition;\n"
