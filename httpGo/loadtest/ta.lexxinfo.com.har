tle\":\"Average Net per -TRADE\",\"type\":\"money\",\"row\":3},\"avg_day_net\":{\"row\":2,\"col\":1,\"title\":\"Average Net per Day\",\"type\":\"money\"},\"avg_profit_net\":{\"row\":2,\"col\":2,\"title\":\"Average Net per +Day\",\"type\":\"money\"}},\"system\":{\"min_date_fills\":1433141722,\"max_date_fills\":1786647511,\"max_date_positions\":1786665600,\"bf_holidays\":[\"2015-01-01\",\"2015-01-19\",\"2015-02-16\",\"2015-04-03\",\"2015-05-25\",\"2015-07-03\",\"2015-09-07\",\"2015-11-26\",\"2015-12-25\",\"2016-01-01\",\"2016-01-18\",\"2016-02-15\",\"2016-03-25\",\"2016-05-30\",\"2016-07-04\",\"2016-09-05\",\"2016-11-24\",\"2016-12-26\",\"2017-01-02\",\"2017-01-16\",\"2017-02-20\",\"2017-04-14\",\"2017-05-29\",\"2017-07-04\",\"2017-09-04\",\"2017-11-23\",\"2017-12-25\",\"2018-01-01\",\"2018-01-15\",\"2018-02-19\",\"2018-03-30\",\"2018-05-28\",\"2018-07-04\",\"2018-09-03\",\"2018-11-22\",\"2018-12-25\"]}}"
