          "content": {
            "size": 6778,
            "compression": -9,
            "mimeType": "application/json",
            "text": "\nfunction cfgHTMX() {\n    if (document && document.body) {\n        document.body.addEventListener('htmx:afterSwap', evt => {\n            htmx.findAll(`input.active-search`).forEach(el => {\n                el.addEventListener('keydown', e => {\n                    switch (e.key) {\n                        case 'ArrowDown':\n                            $(el).nextAll(\"[data-name='search-results']\").children(\"li\")[0].focus();\n                            e.preventDefault();\n                            break;\n                    }\n                })\n            });\n\n            const li = htmx.findAll(`[data-name='search-results'] li`);\n\n            li.forEach(el => {\n                el.tabIndex = 0;\n                el.addEventListener('keydown', e => {\n                    const target = e.target;\n                    const nextEl = target.nextElementSibling;\n                    const prev = target.previousElementSibling;\n\n                    switch (e.key) {\n                        case 'ArrowUp':\n                            prev && prev.focus();\n                            break;\n                        case 'Enter':\n                            target.children[0].click();\n                        // move cursor to next\n                        case 'ArrowDown':\n                            nextEl && nextEl.focus();\n                            break;\n\n                        default:\n                            return;\n                    }\n                    e.preventDefault();\n                });\n            });\n        });\n\n        document.body.addEventListener('htmx:beforeSwap', evt => {\n            if (!evt.detail.elt.attributes.target) {\n                if (evt.detail.xhr.status === 204) {\n                    evt.preventDefault();\n                    if (evt.detail.elt.nodeName === 'OUTPUT') {\n                        evt.detail.elt.textContent = 'request return empty response';\n                        evt.detail.elt.className = 'htmx-swap-error';\n                        setTimeout(()=> {evt.detail.elt.className = '';}, 10000);\n                    } else {\n                        console.log(evt.detail.elt.nodeName)\n                    }\n                }\n                return;\n            }\n            let responseText = evt.detail.xhr.responseText;\n            switch (evt.detail.elt.attributes.target.nodeValue) {\n                case \"_modal\":\n                    fancyOpen(responseText);\n\n                    return false;\n\n                case \"_blank\":\n                    var uri = \"data:text/html,\" + encodeURIComponent(responseText);\n                    var newWindow = window.open('localhost', \"Preview\");\n                    newWindow.document.write(responseText);\n                    newWindow.focus();\n                    setTimeout(function () {\n                        newWindow.setClickAll();\n                    }, 1000);\n\n                    evt.preventDefault();\n                    return false;\n            }\n        });\n        document.body.addEventListener('htmx:afterRequest', evt => {\n            const xhr = evt.detail.xhr;\n            switch (xhr.status) {\n                case 204:\n                    evt.preventDefault();\n                    console.log('request return zero results', xhr);\n                    return false;\n                case 201:\n                    alert(`Successful add record #${xhr.responseText}`);\n                case 200:\n                    htmx.trigger(evt.detail.target, 'on_change');\n                        if (evt.detail.successful && evt.detail.elt.dataset['name'] === \"generate\") {\n                            // 1. Get the current URL path (e.g., \"/dashboard\")\n                            const currentPath = window.location.pathname;\n\n                            // 2. Load existing parameters so you don't overwrite them\n                            const urlParams = new URLSearchParams(window.location.search);\n\n                            // 3. Add or update your specific parameters\n                            const params = evt.detail.requestConfig.formData;\n                            urlParams.set('calendar', params.get(\"calendar\"));\n                            const acc_groups = params.get(\"acc_groups\");\n                            if (acc_groups) {\n                                urlParams.set('acc_groups', acc_groups);\n                            }\n\n                            // 4. Combine the path with the new parameters\n                            const newUrl = currentPath + '?' + urlParams.toString();\n\n                            // 5. Update the address bar without reloading the page\n                            window.history.replaceState({}, '', newUrl);\n                        }\n                    }\n\n        });\n\n        document.body.addEventListener('htmx:responseError', evt => {\n            const xhr = evt.detail.xhr;\n            switch (xhr.status) {\n                case 401:\n                    return relogin(evt);\n                case 400:\n                    // stop the regular request from being issued\n                    evt.preventDefault();\n                    const src = evt.detail.elt;\n                    let obj = JSON.parse(xhr.responseText);\n                    showErrors(obj.formErrors, src)\n            }\n        });\n        document.body.addEventListener('htmx:beforeRequest', evt => {\n            const path = evt.detail.pathInfo.requestPath;\n            if (!token && !(path === '/signin_modal.html' || path === \"/get/token/\")) {\n                evt.preventDefault();\n                return relogin(evt);\n            }\n        });\n\n        document.body.addEventListener('htmx:configRequest', evt => {\n            evt.detail.headers['Authorization'] = 'Bearer ' + token;\n            evt.detail.headers['Accept-Language'] = lang;\n            evt.detail.headers['X-Requested-With'] = 'XMLHttpRequest';\n            // remove header for html responce\n            if (evt.srcElement.getAttribute('hx-swap') === \"json\") {\n                evt.detail.headers['HX-Request'] = false;\n            }\n            if (evt.detail.url) {\n                evt.detail.url = replMacros(evt.detail.url);\n            }\n        });\n\n        // gate htmx requests on the auth token\n        document.body.addEventListener(\"htmx:confirm\", (evt) => {\n            // if there is no auth token\n            if (!token && evt.detail.path !== '/signin_modal.html' && evt.detail.path !== \"/get/token/\") {\n                // stop the regular request from being issued\n                evt.preventDefault();\n                // only issue it once the auth promise has resolved\n                // auth.then(() => evt.detail.issueRequest())\n                console.log(evt.detail);\n                return false;\n            }\n        })\n\n\n    }\n}\n"
          },
