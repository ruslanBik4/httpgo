              "value": "propReports API manager HTTPGO/v2025.01 (linux) backend by Golang go1.26.0(gc) builded on Linux-6.17.0-1020-azure"
            },
            {
              "name": "author",
              "value": "ruslanBik4"
            },
            {
              "name": "Alt-Svc",
              "value": "h3=\":443\"; ma=86400"
            }
          ],
          "content": {
            "size": 57224,
            "compression": -36,
            "mimeType": "application/json",
            "text": "\n\"use strict\";\n\nvar token = localStorage.getItem(\"TOKEN\");\nvar userStruct = getUser();\nvar lang = document.documentElement.lang.split(\",\")[0] || 'en';\nvar pendingRequests = [];\n// must run BEFORE loaded htmx - tools.js must link with defer\nif (!token) {\n    ShowLoginForm();\n}\n// Track modifier keys\nlet keyState = {\n    alt: false,\n    shift: false,\n    meta: false\n};\n\nlet isStay = true;\n\ndocument.addEventListener(\"keydown\", (e) => {\n    keyState.alt   = e.altKey;\n    keyState.shift = e.shiftKey;\n    isStay = false;\n    keyState.meta  = e.metaKey;\n});\n\ndocument.addEventListener(\"keyup\", (e) => {\n    keyState.alt   = false;\n    keyState.shift = false;\n    keyState.meta  = false;\n    isStay = false;\n});\n// end keys tracking\n\nfunction relogin(evt) {\n    token = undefined;\n    console.log(evt);\n    // stop the regular request from being issued\n    evt.preventDefault();\n    const triggeringEvent = evt.detail.triggeringEvent  || 'reload';\n    const elem = evt.detail.elt;\n    if (triggeringEvent === 'reload') {\n        elem.setAttribute(\"hx-trigger\", triggeringEvent);\n        htmx.process(elem);\n    }\n    pendingRequests.push({\n        elt: elem,\n        path: evt.detail.pathInfo.requestPath,\n        verb: evt.detail.verb,\n        triggeringEvent: triggeringEvent\n    });\n    console.log(evt.detail);\n    const ovl = ShowLoginForm();\n    htmx.process(ovl);\n    htmx.trigger(ovl, \"load\");\n    return false;\n}\n\nLoadJScript('/js/cfgHTMX.js', false, true, ()=> {return cfgHTMX();});\n\nif (document.getElementById('t_earnings_stat') !== null) {\n    LoadJScript(\"/js/tables.js\", true, true);\n}\n\nloadCharts(document);\n\nfunction getRealStyle(elem, name) {\n    return window.getComputedStyle(elem)[name];\n}\n\nvar chartsLoaded = false;\n/**\n * Load charts script according to params if parent consist of any chart templartes.\n *\n * @param {NodeElement} parent.\n * @param {function} succesful - function that will be invoke after loading.\n * @returns {void}\n */\nfunction loadCharts(parent, succesful) {\n    if ($('[data-name$=_chart_pie]', parent).length > 0 && window.ShowTimeCandles === undefined) {\n        LoadJScript(\"https://cdnjs.cloudflare.com/ajax/libs/tinycolor/1.4.2/tinycolor.min.js\", false, true)\n    }\n    if ($(\".LineChart, .Candlestick\", parent).length > 0 && window.ShowTimeCandles === undefined) {\n        console.log('start loading charts');\n        if (chartsLoaded) {\n            succesful();\n        }\n\n        LoadJScript(\"https://www.gstatic.com/charts/loader.js\", false, true, () => {\n            LoadJScript(\"/js/drawLineChart.js\", false, true, () => {\n                LoadJScript(\"/js/charts.js\", false, true, (url) => {\n                    LoadJScript(\"/js/tradingView.js\", false, true, () => {\n                        console.log('finish loading charts');\n                        chartsLoaded = true;\n                        if (succesful) {\n                            succesful();\n                        }\n                    });\n                });\n            });\n        });\n    }\n}\n\nfunction getUser() {\n    if (token)\n        return;\n\n    let user = localStorage.getItem(\"USER\");\n    if (user > '') try {\n        let userData = JSON.parse(user);\n        token = userData.token || userData.access_token || userData.bearer_token || userData.auth_token;\n        return userData;\n    } catch (error) {\n        console.warn(\"Error on parsing USER\");\n    }\n}\n\nconst datesConstraints = 'CONSTRAINTS_DATE';\n\nfunction SaveUser(event) {\n    userStruct = JSON.parse(event.detail.xhr.responseText);\n    let dateSystem = userStruct.system;\n    token = userStruct.access_token || userStruct.token;\n    localStorage.setItem(\"TOKEN\", token);\n    let dates = {\n        minDate : dateSystem.min_date_fills,\n        maxDate : new Date(1000*dateSystem.max_date_fills),\n        holidays : dateSystem.bf_holidays,\n    };\n    localStorage.setItem(datesConstraints, JSON.stringify(dates));\n    htmx.find('#login_form').remove();\n    if (pendingRequests) {\n        pendingRequests.forEach((item) => {\n            htmx.trigger(item.elt, item.triggeringEvent);\n        })\n    }\n    htmx.process(document.body);\n    return false;\n}\n\nfunction ShowLoginForm() {\n    const ovl = document.getElementById('login_form');\n    if (ovl) {\n        return ovl;\n    }\n    // Create overlay\n    const dialog = document.createElement(\"dialog\");\n    dialog.setAttribute('id','login_form');\n    dialog.style.position = \"fixed\";\n    dialog.style.top = 0;\n    dialog.style.left = 0;\n    dialog.style.width = \"100%\";\n    dialog.style.height = \"100%\";\n    dialog.style.background = \"rgba(0,0,0,0.5)\";\n    dialog.style.display = \"flex\";\n    dialog.style.alignItems = \"center\";\n    dialog.style.justifyContent = \"center\";\n    dialog.style.zIndex = \"10000\";\n    dialog.setAttribute('hx-get', '/signin_modal.html');\n    dialog.setAttribute('hx-trigger', 'load');\n    document.body.prepend(dialog);\n    dialog.showModal();\n\n    return dialog;\n}\nfunction createObserver() {\n// Create a MutationObserver instance\n    const observer = new MutationObserver((mutationsList, observer) => {\n        for (const mutation of mutationsList) {\n            if (mutation.type === \"childList\") {\n                mutation.addedNodes.forEach(node => { processAll(node); } );\n            } else if (mutation.type === \"attributes\") {\n                let ignores = [\"style\", \"class\", \"rel\"];\n                if (ignores.indexOf(mutation.attributeName) > -1) {\n                    return\n                }\n                console.debug(\"Attributes changed:\", mutation);\n            } else if (mutation.type === \"characterData\") {\n                console.debug(\"Text content changed:\", mutation);\n            } else {\n                console.error(\"Attributes not changed:\", mutation);\n            }\n        }\n    });\n// Configure observer options\n    const config = {\n        childList: true,      // Detect when children are added/removed\n        attributes: true,     // Detect attribute changes\n        subtree: true,        // Observe all descendants\n        characterData: true   // Detect text content changes\n    };\n\n    observer.observe(document.body, config);\n    console.log('observer created')\n}\nfunction AddCalendar() {\n    let parent = $('[data-name=\"input_calendar_date-range\"]');\n    parent.append('<input type=\"date-range\" name=\"calendar\"/>');\n    setDatePopUp('date-range', parent);\n}\n\nfunction checkDates(parent) {\n    if ($('input[type=date],[type=date-range]', parent).length > 0) {\n        if (window.setFlatPickr === undefined) {\n            LoadJScript(\"/js/setFlatPickr.js\", true, true, () => {\n                setFlatPickr(parent)\n            });\n        } else {\n            setFlatPickr(parent);\n        }\n    }\n}\n\nfunction processAll(parent) {\n    if (parent) {\n        loadCharts(parent);\n        checkDates(parent);\n        htmx.process(parent);\n        return;\n    }\n    console.error('is empty parent');\n}\n\nfunction submitAfterUpdate(elem) {\n    const form = elem.closest(\"form\");\n    if (form) {\n        requestAnimationFrame(() => requestAnimationFrame(() => {\n            htmx.trigger(form, 'submit')\n        }));\n    }\n}\n\nfunction submitWhenAlt(elem) {\n    // --- ALT: submit form ---\n    if (keyState.alt) {\n        elem.close();\n        submitAfterUpdate(elem._input);\n    }\n}\n\n$(function () {\n\n    console.log('observer');\n    checkDates(document.body);\n    createObserver();\n    const $form = $('form[data-name=\"generate\"], form[data-name=\"big-picture\"]');\n    if ($form.length > 0) {\n        let url = new URL(window.location.href);\n        let params = new URLSearchParams(url.search);\n        let accGroups = params.get(\"acc_groups\");\n        let account = params.get(\"account\");\n        let calendar = params.get(\"calendar\");\n//toottipa color, background remove\n// dragiin         drag up-down\n        //db click open journal\n        // on ogff month\n        // sort\n        setTimeout(function () {\n            if (calendar) {\n                $('input[name=calendar]', $form)[0]._flatpickr.input.value = calendar;\n            }\n            if (account) {\n                $('input[name=account]', $form).val(account);\n            }\n            if (accGroups) {\n                $('ol[data-name=\"ol_selected\"]', $form).append(`<li><span hx-on:click=\"return AddAccounts(this, event);\" data-value=\"${accGroups}\">${accGroups}<input type=\"hidden\" name=\"acc_groups\" value=\"${accGroups}\"></span></li>`);\n            }\n            if (accGroups || calendar || account || isStay) {\n                htmx.trigger($form[0], 'submit');\n            }\n        }, 1000);\n    }\n})\n\nfunction rangeFromYears(years) {\n    const result = [];\n    for (let y = years.from; y <= years.to; y++) {\n        result.push(y);\n    }\n    return result;\n}\n\n// get lines for table according to windows height\nfunction GetPageLines() {\n    return Math.round((window.innerHeight - 60) / 22)\n}\n\n\nfunction isScrollableY(node) {\n    const overflowY = window.getComputedStyle(node)['overflow-y'];\n    return (overflowY === 'scroll' || overflowY === 'auto');\n}\n\n\nHTMLCollection.prototype.forEach = Array.prototype.forEach;\nNodeList.prototype.forEach = Array.prototype.forEach;\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n    // Detect mobile devices (iPads, iPhones, Android)\n    function isMobileDevice() {\n        return /Mobi|Android|iPhone|iPad/i.test(navigator.userAgent);\n    }\n\n    if (isMobileDevice()) {\n        document.querySelectorAll(\"[onmouseenter]\").forEach(el => {\n            let existingHandler = el.getAttribute(\"onmouseenter\"); // Get the inline event\n            el.removeAttribute(\"onmouseenter\"); // Remove the old event to avoid duplication\n\n            // Attach new event for mobile devices\n            el.addEventListener(\"touchstart\", function () {\n                eval(existingHandler); // Run the original handler\n                console.log(\"Touchstart triggered instead of mouseenter for:\", el);\n            }, {passive: true});\n        });\n        if (isMobileDevice()) {\n            document.querySelectorAll(\"[hx-on\\\\:mouseenter]\").forEach(el => {\n                let existingHandler = el.getAttribute(\"hx-on:mouseenter\"); // Get original handler\n                el.removeAttribute(\"hx-on:mouseenter\"); // Remove old event to prevent duplication\n\n                // Add touch equivalent\n                el.setAttribute(\"hx-on:touchstart\", existingHandler);\n\n                console.log('Replaced \"hx-on:mouseenter\" with \"hx-on:touchstart\" for:', el);\n            });\n\n            console.log(\"Mobile detected: Modified hx-on:mouseenter.\");\n        } else {\n            console.log(\"Desktop detected: No changes.\");\n        }\n\n        console.log(\"Mobile detected: mouseenter replaced with touchstart.\");\n    } else {\n        console.log(\"Desktop detected: mouseenter remains unchanged.\");\n    }\n});\n\nfunction copyAttr(old, n) {\n    // 2. Import the node into the current document context\n    let importedNode = document.importNode(old, true);\n    // 3. Loop through and copy each attribute\n    for (let attr of old.attributes) {\n        n.setAttributeNode(attr.cloneNode(true));\n    }\n}\n\nfunction copyOnChange(parent, child) {\n    if (parent && parent.getAttribute) {\n        const hxOnOnChange = \"hx-on:on_change\";\n        let attr = parent.getAttribute(hxOnOnChange);\n        if (attr) {\n            child.setAttribute(hxOnOnChange, attr);\n        }\n    }\n}\n\nfunction getMainContent() {\n    return htmx.find('.tpl').content\n}\n// temporary seach as class\nfunction getComponentByID(id) {\n    return getMainContent().getElementById(id);\n}\n\nfunction getComponentByClass(name) {\n    return getMainContent().querySelector('.'+ name);\n}\n\nfunction getComponentByName(name) {\n    return getMainContent().querySelector(`[data-name=\"${name}\"]`);\n}\n\nfunction createInstanceByComponent(newInstance) {\n    let n = newInstance.cloneNode(true);\n    copyOnChange(newInstance.parentNode, n);\n    copyAttr(newInstance, n);\n    n.classList.remove('component');\n    n.classList.add('instance');\n\n    return n;\n}\n\nfunction createInstanceByID(id) {\n    let newInstance = getComponentByID(id);\n    if (!newInstance) {\n        console.log(`${id} CngInstance not found`);\n        return null;\n    }\n\n    return createInstanceByComponent(newInstance);\n}\n\nfunction createInstanceByClass(name) {\n    let newInstance = getComponentByClass(name);\n    if (!newInstance) {\n        console.log(`${name} CngInstance not found`);\n        return null;\n    }\n    // newInstance.classList.add(name);\n    console.debug(newInstance);\n\n    return createInstanceByComponent(newInstance);\n}\n\nfunction createInstanceByName(name) {\n    let newInstance = getComponentByName(name);\n    if (!newInstance) {\n        console.log(`${name} CngInstance not found`);\n        return null;\n    }\n\n    return createInstanceByComponent(newInstance);\n}\n\nwindow.TransitionReady ??= new Promise(resolve => {\n\n    if (window.Transition) {\n        resolve(window.Transition);\n        return;\n    }\n\n    LoadJScript(\"/js/transition.js\", false, true, () => {\n        resolve(window.Transition);\n    });\n\n});\n\nfunction AddTplCngInstance(elem, tpl) {\n    let n = createInstanceByClass(tpl);\n    animateReplace(elem,n);\n}\n\nasync function animateReplace(elem, n) {\n\n    await window.TransitionReady;\n\n    await Transition.play(elem, n, () => {\n\n        htmx.process(n);\n        htmx.trigger(n, 'on_change');\n\n        n.querySelector(\"input\")?.focus();\n    })\n}\n\nfunction convertHumanReadably(number) {\n    const postfixes = ['', 'k', 'M', 'B', 't'];\n    let count = 0;\n    number *= 1;\n    if (Math.abs(number) < 1000) {\n        return number.toFixed(2);\n\n    }\n    while (Math.abs(number) >= 1000 && count < postfixes.length) {\n        number /= 1000\n        count++\n    }\n\n    return number.toFixed(2) + postfixes[count];\n}\n\nfunction colorizeChildren(elem) {\n    $('span, div[json-text]', elem).each((i, el) => {\n        const classList = el.classList;\n        if (el.textContent.startsWith('-') || el.textContent.startsWith('0.')) {\n            classList.add(\"money-negative\");\n            classList.remove(\"money-positive\");\n        } else if (/^\\d+\\.\\d+/.test(el.textContent)) {\n            classList.add(\"money-positive\");\n            classList.remove(\"money-negative\");\n        }\n    });\n}\n\n// Функция — красит число\nfunction colorize(el, num) {\n    el.classList.remove(\"value-positive\", \"value-negative\");\n    if (num > 0) el.classList.add(\"value-positive\");\n    else el.classList.add(\"value-negative\"); // 0 тоже красный\n}\n\n\nfunction AddTplChildren(parent, tpl) {\n    getMainContent().getElementById(tpl).children.forEach(function (el, i) {\n        parent.appendChild(el.cloneNode(true));\n    })\n    htmx.process(parent);\n    let input = parent.getElementsByTagName('input')[0];\n    if (input) input.focus();\n}\n\nfunction AddTpByNamel(name, tpl, replaceChildren) {\n    return AddTpl( htmx.find(`[data-name=${name}]`), tpl, replaceChildren);\n}\n\nfunction AddTpl(parent, tpl, replaceChildren) {\n    if (!parent) {\n        console.log(`parent for ${tpl}  not found`);\n        return;\n    }\n    parent.classList.add('htmx-settling');\n    let e = parent.getElementsByClassName(tpl);\n    if (e.length > 0) {\n        e[0].style.visibility = 'visible';\n        return;\n    }\n\n    let n = createInstanceByClass(tpl);\n    if (!n) {\n        console.log(`${tpl}  not found`);\n        return;\n    }\n    // n.classList.add(\"hover_visible\");\n    if (replaceChildren) {\n        parent.replaceChildren();\n    }\n\n    switch (window.getComputedStyle(parent)[\"flexDirection\"]) {\n    case \"column\":\n        n.style.height = \"auto\";\n        n.style.flexGrow = \"1\";\n        break;\n    case \"row\":\n        n.style.w = \"auto\";\n        n.style.flexGrow = \"1\";\n    }\n\n    parent.appendChild(n);\n    htmx.process(parent);\n    let input = parent.getElementsByTagName('input')[0];\n    if (input) input.focus();\n}\n\nfunction AddTplOverlay(parent, tpl) {\n    let e = document.getElementById(tpl);\n    let zIndex = parent.style.zIndex + 100;\n    if (e !== null) {\n        e.style.zIndex = zIndex;\n        return;\n    }\n\n    let popup = getMainContent().getElementById(tpl).cloneNode(true);\n    const rect = parent.getBoundingClientRect();\n    popup.style.position = \"sticky\";\n    popup.style.transform = `matrix(1.00, 0.00, 0.00,  1.00, ${rect.left}, ${rect.top})`;\n    popup.style.zIndex = zIndex;\n    popup.addEventListener('mouseleave', (e) => {\n        popup.style.zIndex = -1000;\n    });\n    document.body.appendChild(popup);\n    htmx.process(popup);\n    let input = parent.getElementsByTagName('input')[0];\n    if (input) input.focus();\n}\n\nfunction GoSubmit(el, name) {\n    let f = name ? htmx.find(`form[data-name=${name}]`) : el.closest('form');\n    htmx.trigger(f, 'submit');\n}\nfunction AfterSubmit(event) {\n    let elem = event.detail.elt;\n    let target = event.detail.target;\n    elem.style.visibility = 'visible';\n    if (target) {\n        $(target).show();\n    } else if (event.detail.successful) {\n        $(elem).closest('div').show(); //style.visibility = ? 'visible' : 'hidden';\n    }\n}\n\nfunction AfterSavePlan(event) {\n    let thisForm = event.detail.elt;\n    if (event.detail.successful && thisForm.nodeName === 'FORM') {\n        thisForm.reset();\n        thisForm.querySelector('[data-name=\"ol_selected\"]').innerHTML = \"\";\n        flatpickr('input[name=calendar]').setDate([new Date()]);\n        htmx.trigger( htmx.find('form[data-name=generate]'), 'submit');\n    }\n}\n\nfunction AfterSavePlanChanged(event) {\n    let thisForm = event.detail.elt;\n    if (event.detail.successful && thisForm.nodeName === 'FORM') {\n        // flatpickr('input[name=calendar]').setDate([new Date()]);\n        htmx.trigger( htmx.find('form[data-name=generate]'), 'submit');\n        $('button', thisForm).show().removeClass('main-btn').addClass('hidden');\n    }\n}\n\n\nfunction toggleAllChk() {\n    const event = window.event;\n    const target = event.target || event.srcElement;\n    $(target).closest('div').next('div, ul, ol').find('input').click();\n}\n\nfunction createNewInput(name, value, typ) {\n    const newInput = document.createElement('input');\n    newInput.type = typ;\n    newInput.name = name;\n    newInput.value = value;\n    return newInput;\n}\n\nfunction createNewTextArea(name, value, cols) {\n    const newInput = document.createElement('textarea');\n    newInput.cols = cols || 30;\n    newInput.name = name;\n    newInput.value = value;\n    newInput.oninput = TextAreaInput;\n    return newInput;\n}\n\nfunction AddAccounts(el, evt) {\n\n    let li = el.parentNode;\n    const container = li.closest(\"div\");\n    let comment = li.previousSibling;\n    while (comment instanceof Text) {\n        comment = comment.previousSibling;\n    }\n\n    //  move span into ol_selected & add input\n    const closest = $(li).closest(\"div\").find('[data-name=\"ol_selected\"]')[0];\n    const inp = $(`input[value=\"${el.dataset.value}\"]`, closest);\n    // input already inside ol_selected - remove this\n    if (inp.length > 0) {\n        // inp[0].remove();\n        // return into search_result\n        // let i = 1;\n        // const n = parseInt(comment.nodeValue, 10);\n        //\n        // for (const child of closest.childNodes) {\n        //     if (child.nodeType === Node.ELEMENT_NODE && n <= i) {\n        //         let nextText = child.nextSibling;\n        //         closest.insertBefore(li, nextText);\n        //         closest.insertBefore(comment, li);\n        //         return\n        //     }\n        //     if (child.nextSibling instanceof Comment) {\n        //         i = parseInt(child.nextSibling.nodeValue, 10)+1;\n        //     }\n        // }\n    } else {\n        // create input according to el dataset\n        const newInput = createNewInput(el.dataset.name, el.dataset.value, 'hidden');\n        const newLi = document.createElement('li');\n        const newSpan = document.createElement('span');\n        newSpan.innerText = el.innerText;\n        newLi.onclick = (evt) => { newLi.remove();};\n        newSpan.appendChild(newInput);\n        newLi.appendChild(newSpan);\n        closest.appendChild(newLi);\n        // when Shift pressed - save search result otherwise clear\n        if (!keyState.shift) {\n            $('input.active-search',container).val(\"\").focus();\n        }\n        // when Alt - submit Form\n        if (keyState.alt) {\n            htmx.trigger(container.closest('form'), 'submit');\n        }\n    }\n}\n\nlet big_picture = {crossdata: {}};\n\nconst defTimeZone = { timeZone: 'Europe/London' };\n\nconst defLocales = 'en-US';\n\n// Returns only the date: \"YYYY-MM-DD\"\nfunction UnixTimetoDate(ut) {\n    return new Date(ut * 1000).toISOString().slice(0, 10);\n}\n\n// Returns only the time: \"HH:mm:ss\"\nfunction UnixTimetoTime(ut) {\n    return new Date(ut * 1000).toISOString().slice(11, 19);\n}\n\n// Returns date and time together: \"YYYY-MM-DD HH:mm:ss\"\nfunction UnixTimetoLocal(ut) {\n    const iso = new Date(ut * 1000).toISOString();\n    return `${iso.slice(0, 10)} ${iso.slice(11, 19)}`;\n}\n\n//replace special symbols\nfunction replMacros(url) {\n    return url.replace(/{page}/, GetPageLines() * 2)\n}\nfunction IsEmpty(elem) {\n    // if (elem.value === '') {\n        $(elem).closest('details').attr('open', true);\n        elem.focus();\n            $(elem).nextAll('.errorLabel').html(getErrorMessage(elem));\n\n    // }\n}\n\nfunction getErrorMessage(elem) {\n    const v = elem.validity;\n\n    if (v.valueMissing)   return `<b>${elem.name}</b> is required!`;\n    if (v.typeMismatch)   return \"Invalid format.\";\n    if (v.patternMismatch)return \"Invalid format.\";\n    if (v.tooShort)       return `Minimum ${elem.minLength} characters.`;\n    if (v.tooLong)        return `Maximum ${elem.maxLength} characters.`;\n    if (v.rangeUnderflow) return `Minimum value is ${elem.min}.`;\n    if (v.rangeOverflow)  return `Maximum value is ${elem.max}.`;\n    return \"Invalid value.\";\n}\n\nfunction optionClick(el) {\n    let parent = el.closest('div');\n    parent.nextElementSibling.textContent = el.textContent;\n    parent.classList.add(\"hover_visible\");\n}\n\nfunction createAndAddInstance(parent, component) {\n\n    // Create <div>\n    let n = document.createElement(component.nodeName);\n    n.className = component.className;\n    // Copy hx-on:on_change from parent <template> wrapper (if exists)\n    copyOnChange(component, n);\n    copyAttr(component, n);\n    n.classList.remove('component');\n    n.classList.add('instance');\n\n\n    // Copy children\n    let children = [...component.cloneNode(true).children];\n    children.forEach((child) => {\n        n.appendChild(child);\n    });\n\n    parent.appendChild(n);\n\n    // Process with htmx\n    htmx.process(n);\n    htmx.trigger(n, 'on_clone');\n\n    return n;\n}\n\nfunction setCellsStyles(visibleHeaders, tableContent) {\n    window.requestAnimationFrame(() => {\n        window.requestAnimationFrame(() => {\n            visibleHeaders.forEach((header, i) => {\n                const className = `.usr-table-cell${header.name}`;\n                if (header.children) {\n                    header.children.forEach((item, i) => {\n                        setMaxWidthByClass(`${className}${i + 1}`);\n                    })\n                } else {\n                    setMaxWidthByClass(className);\n                }\n                changeOrCreateCssSelector(className,\n                    {\n                        display: header.display,\n                        // justifyContent: `${header.align === \"left\" ? \"flex-start\" : \"flex-end\"}`\n                    });\n                changeOrCreateCssSelector(`.usr-table .usr-table-row > ${className}`,\n                    {\n                        // display: header.display,\n                        justifyContent: `${header.align === \"left\" ? \"flex-start\" : \"flex-end\"}`\n                    });\n            });\n            tableContent.style.visibility = 'visible';\n\n        });\n    });\n}\n\nfunction addGroupOption(text, id, groupSelect) {\n    const option = document.createElement(\"option\");\n    option.textContent = text;\n    option.value = id;\n    option.style.cursor = \"pointer\";\n    groupSelect.appendChild(option);\n}\n\nfunction createCell() {\n    const cell = document.createElement('div');\n    cell.className = `usr-table-col`;\n    return cell;\n}\n\nfunction createPhotosSpan(name, el) {\n    const newSpan = document.createElement('span');\n    newSpan.className = \"hiddenInput\";\n    newSpan.style.flexGrow = 1;\n    newSpan.style.backgroundSize = 'contain';\n    const input = createNewInput(name, '', el.type || 'file');\n    input.setAttribute('accept', el.accept || 'image/*');\n    input.onchange = handleFileOnForm;\n    input.dataset.placeholder = el.label || name;\n    newSpan.append(input);\n    if (!el.values) {\n        el.values = el.value || \"\";\n    }\n\n    let values = el.values.split(',')\n    let comma = '';\n    let size = Math.round(100.00 / values.length);\n    values.forEach((val, ind) => {\n        if (el.src && val > \"\") {\n            let img = newSpan.style.background;\n            newSpan.style.background += `${comma}url(${el.src.replace('values', val)}) ${ind * size}% center / ${size}% no-repeat`;\n            comma = ', ';\n        }\n    });\n\n    return newSpan;\n}\n\n/**\n * @typedef {Object} TableContainer\n * @property {number} x - Координата X.\n * @property {number} y - Координата Y.\n */\n/**\n * Create row for table and add group market when it preent.\n *\n * @param {object | string} title - title of table.\n * @param {object} tableHeader - header.\n * @param {TableContainer} rows - content rows.\n * @param {object} groupSelect - select.\n * @param {object} postForm - select.\n * @returns {string, undefined} group value\n */\nfunction addGroupRow(title, tableHeader, rows, groupSelect, postForm) {\n    const row = createDataRow(tableHeader);\n    Object.assign(row.style, {\n        width: '100%',\n        minWidth: '100%',\n        justifyContent: 'space-between'\n    });\n\n    const cell = createCell();\n\n    function saveTitle(title) {\n\n        row.id = `id_${title}`;\n        cell.textContent = title;\n        row.appendChild(cell);\n        row.dataset.group = title;\n        addGroupOption(cell.textContent, row.id, groupSelect);\n    }\n\n    if (typeof title === 'object') {\n        if (title.title) {\n            row.id = `id_${title.title}`;\n            if (title.type === 'date') {\n                saveTitle(UnixTimetoDate(title.title));\n            } else {\n                saveTitle(title.title);\n            }\n        } else {\n            saveTitle(Object.values(title)[0]); //todo: implement in future now nothing to parsing\n        }\n\n        if (title.elements) {\n            Object.entries(title.elements).forEach((key, val) => {\n                const cell = createCell();\n                cell.textContent = `${key}=${val}`;\n                row.appendChild(cell);\n            });\n        }\n\n    } else {\n        saveTitle(title);\n    }\n\n    if (postForm && typeof postForm === 'object') {\n        postForm.forEach((f) => {\n            if (typeof f !== 'object' || !f.fields) {\n                return\n            }\n            const form = document.createElement('form');\n            Object.assign(form.style, {\n                flexDirection: 'row',\n                display: \"flex\",\n                position: 'relative',\n            });\n            form.setAttribute('enctype', 'multipart/form-data');\n            form.setAttribute('action', f.action);\n            form.setAttribute('hx-target', 'find output');\n            form.setAttribute('hx-boost', \"true\");\n            form.setAttribute('hx-history', \"false\");\n            form.setAttribute('hx-push-url', \"false\");\n            form.setAttribute('method', f.method || 'post');\n            form.oninput = ()=> {return FormIsModified();};\n            form.onchange = ()=> {return FormIsModified();};\n\n            Object.keys(f.fields).forEach(name => {\n                const el = f.fields[name];\n                if (el.value === 'day') {\n                    el.value = title.title || row.dataset.group;\n                }\n                const cell = createCell();\n                let newInput\n                switch (el.type) {\n                    case 'textarea':\n                        newInput = createNewTextArea(name, el.value, el.cols);\n                        break;\n\n                    case 'file':\n                        Object.assign(cell.style, {\n                            flexDirection: 'row',\n                            display: \"flex\",\n                            position: 'relative',\n                        });\n                        newInput = createPhotosSpan(name, el);\n\n                        break;\n\n                    default:\n                        newInput = createNewInput(name, el.value || \"\", el.type || \"text\");\n                }\n                cell.appendChild(newInput);\n                form.appendChild(cell);\n            });\n            const btn = document.createElement('button');\n            btn.type = 'submit';\n            btn.className = \"hidden\";\n            btn.innerText = 'Save';\n            Object.assign(btn.style, {position: 'absolute', bottom: '1%', right: \"1%\"});\n            form.appendChild(btn);\n            const out = document.createElement('output');\n            form.appendChild(out);\n            row.appendChild(form);\n            // div.setAttribute('hx-get', 'table/notes/form?html=true');\n            // row.appendChild(div);\n        })\n    }\n    rows.appendChild(row);\n    return row.dataset.group;\n}\n\nfunction TextAreaInput(event) {\n    const el = event.target || event.currentTarget;\n    el.style.height = 'auto';\n    el.style.height = el.scrollHeight+'px';\n    el.style.width = 'auto';\n    el.style.width = el.scrollWidth+'px';\n}\n\nfunction FullScreenParrent(elem) {\n    const container = elem.parentNode.parentNode.parentNode;\n    if (!document.fullscreenElement) {\n        container.requestFullscreen();\n    } else {\n        document.exitFullscreen();\n    }\n    return false\n}\nfunction copyStyles(fromEl, toEl, listOfStyles) {\n    const styles = window.getComputedStyle(fromEl);\n    for (let prop of styles) {\n        if (listOfStyles.includes(prop)) {\n            toEl.style.setProperty(prop, styles.getPropertyValue(prop), styles.getPropertyPriority(prop));\n        }\n    }\n}\n\nfunction setMaxWidthByClass(selector) {\n    const elements = document.querySelectorAll(selector);\n    if (elements.length < 1) {\n        console.error(`No elements were found by ${selector}`);\n        return;\n    }\n\n    // Find the maximum computed width among all elements\n    let minWidth = 0;\n    elements.forEach((el,i ) => {\n        const width = Math.max( el.offsetWidth, el.getBoundingClientRect().width,\n            computeCssWidthForCell(el, el.textContent) + (i===0 ? 24 : 0)); // add prefix+suffix for header\n        if (width > minWidth) minWidth = width;\n    });\n\n    changeOrCreateCssSelector(selector, (minWidth < 500 ? {minWidth: `${minWidth}px`} : {width: `500px`, overflowX: 'auto', cursor: 'row-resize', wordBreak: 'break-word' } ) );\n}\n\n// measure text using computed font from the element\nfunction getTextWidth(text, el) {\n    if (text == null) text = \"\";\n    const canvas = getTextWidth._canvas || (getTextWidth._canvas = document.createElement(\"canvas\"));\n    const ctx = canvas.getContext(\"2d\");\n\n    const style = window.getComputedStyle(el);\n\n    // respect text-transform (uppercase/lowercase/capitalize)\n    let measuredText = String(text);\n    const tt = style.textTransform;\n    if (tt === \"uppercase\") measuredText = measuredText.toUpperCase();\n    else if (tt === \"lowercase\") measuredText = measuredText.toLowerCase();\n    else if (tt === \"capitalize\") measuredText = measuredText.replace(/\\b\\w/g, c => c.toUpperCase());\n\n    // use computed font shorthand if available, otherwise build it\n    // getComputedStyle().font often returns the full font string; fallback to building one\n    const font = style.font && style.font !== \"normal\" ? style.font\n        : `${style.fontStyle} ${style.fontVariant} ${style.fontWeight} ${style.fontSize}/${style.lineHeight} ${style.fontFamily}`;\n\n    ctx.font = font;\n\n    // base width\n    let width = ctx.measureText(measuredText).width;\n\n    // account for letter-spacing (canvas doesn't apply letter-spacing)\n    const ls = style.letterSpacing;\n    if (ls && ls !== \"normal\") {\n        const lsPx = parseFloat(ls);\n        if (!isNaN(lsPx) && measuredText.length > 1) {\n            width += lsPx * (measuredText.length - 1);\n        }\n    }\n\n    return width;\n}\n// compute CSS width to set on the cell so the text fits.\n// This returns a pixel value (number).\nfunction computeCssWidthForCell(cell, text) {\n    const style = window.getComputedStyle(cell);\n    const contentWidth = getTextWidth(text, cell);\n\n    // if the element uses border-box, the CSS 'width' includes padding+border.\n    const addForBoxSizing = style.boxSizing === \"border-box\"\n        ? (parseFloat(style.paddingLeft || 0) + parseFloat(style.paddingRight || 0)\n            + parseFloat(style.borderLeftWidth || 0) + parseFloat(style.borderRightWidth || 0))\n        : 0;\n\n    // small safety gap so text+cursor don't touch edges\n    const safety = 2;\n\n    return Math.ceil(contentWidth + addForBoxSizing + safety);\n}\n\nfunction createJournalTable(evt) {\n    const status = evt.detail.xhr.status;\n    if (status !== 200) {\n        console.log('Error: Invalid XHR status: ' + status);\n        console.log(evt.detail.xhr.responseText);\n        return;\n    }\n\n    // chk present class\n    if (typeof JournalTable === \"undefined\") {\n        LoadJScript('/js/journalTable.js', false, true, ()=> { renderJournalTable(evt); });\n    } else {\n        renderJournalTable(evt);\n    }\n}\nfunction renderJournalTable(evt) {\n    evt.preventDefault();\n    const journal = new JournalTable();\n    const target = $('[data-name=\"usr-table\"]', evt.target)[0] || $('[data-name=\"usr-table\"]', evt.target.target)[0] || $('[data-name=\"usr-table\"]')[0];\n    journal.init(target, JSON.parse(evt.detail.xhr.response));\n}\n\nfunction addClick(elem, cfg, params) {\n    elem.setAttribute('hx-vals', JSON.stringify(params || cfg.params));\n    if (cfg.link_method === \"get\") {\n        elem.setAttribute('hx-get', cfg.link);\n    } else if (cfg.link_method === \"post\"){\n        elem.setAttribute('hx-post', cfg.link);\n    } else {\n        elem.setAttribute('hx-on:click', cfg.link);\n    }\n    if(cfg[\"hx-select\"]) {\n        elem.setAttribute('hx-select', cfg[\"hx-select\"]);\n    }\n    if(cfg[\"hx-trigger\"]) {\n        elem.setAttribute('hx-trigger', cfg[\"hx-trigger\"]);\n    }\n    switch (cfg.target) {\n        case \"self\":\n            elem.setAttribute('hx-target', 'next');\n            elem.setAttribute('hx-ext', 'json-swap');\n            elem.setAttribute('hx-swap', 'json');\n            elem.setAttribute('hx-encoding', \"multipart/form-data\");\n\n            let target = createAndAddInstance(elem.parentNode, createInstanceByClass('journal_trades2207283'));\n            Object.assign(target.style, {\n                left: '-100000px',\n                visibility: 'hidden',\n                position  : 'absolute',\n                width     : $('[data-name=Body]').width() + 'px'\n            });\n\n            const $CandlestickElement = $('.Candlestick.instance', target)[0];\n            $CandlestickElement.dataset[\"minutes\"] = 5;\n            // store full params\n            $CandlestickElement.dataset.params = JSON.stringify(params || cfg.params);\n            $CandlestickElement.setAttribute('hx-vals', `js:{\n    ...(JSON.parse(this.dataset.params)),\n    minutes: this.dataset.minutes\n}` );\n            target.addEventListener(`htmx:afterSwap`,() => {\n                showSelfChild();\n                // elem.removeAttribute(`hx-${cfg.link_method}`);\n                elem.addEventListener(`click`, (e) => {\n                    $(target).toggle();\n                    e.preventDefault();\n                    return false\n                });\n                htmx.process(elem);\n            });\n            break;\n\n        case \"open\":\n            elem.setAttribute( 'target', '_blank' );\n        case \"this\":\n            elem.setAttribute( 'hx-target', 'this' );\n        case \"\":\n        case undefined:\n            break;\n        default:\n            elem.setAttribute( 'target', cfg.target );\n    }\n\n    elem.style.cursor = 'pointer';\n}\n\nfunction showSelfChild() {\n    let parent = event.target;\n    Object.assign(parent.style, {\n        visibility: 'visible',\n        left: '0',\n        position: 'relative'\n    });\n\n    let elem =  $('.Candlestick.instance', parent)[0];\n    elem.setAttribute('hx-trigger', \"load, reload\" );\n    elem.setAttribute('hx-post', elem.dataset[\"url\"]);\n    elem.setAttribute('hx-target', 'this');\n    elem.setAttribute('hx-swap', 'none');\n    elem.addEventListener(`htmx:afterSwap`,() => {event.stopPropagation();} );\n    htmx.process(elem);\n    // enableDragScroll(elem.parentNode);\n}\n\nfunction enableDragScroll(el) {\n    let isDown = false;\n    let startX;\n    let scrollLeft;\n\n    el.addEventListener('mousedown', (e) => {\n    isDown = true;\n    startX = e.pageX - el.offsetLeft;\n    scrollLeft = el.scrollLeft;\n    el.style.cursor = 'grabbing';\n});\n\n    el.addEventListener('mouseleave', () => {\n    isDown = false;\n    el.style.cursor = 'grab';\n});\n\n    el.addEventListener('mouseup', () => {\n    isDown = false;\n    el.style.cursor = 'grab';\n});\n\n    el.addEventListener('mousemove', (e) => {\n    if (!isDown) return;\n    e.preventDefault();\n\n    const x = e.pageX - el.offsetLeft;\n    const walk = (x - startX); // speed multiplier optional\n    el.scrollLeft = scrollLeft - walk;\n});\n\n    el.style.cursor = 'grab';\n}\nfunction setMinutes(el) {\n    const ohlc = $(el).closest('[data-name=\"title_charts\"]').next('div').find('div')[0];\n\n    const params = ohlc.params;\n    if (el.dataset?.name && el.dataset?.value) {\n        params[el.dataset?.name] = el.dataset?.value;\n        $('[data-name=compareType]').removeClass('hidden');\n    } else {\n        // 1. update ONLY minutes\n        params.minutes = el.innerText.trim();\n    }\n\n    ohlc.params = params;\n    // 2. trigger reload (NOT load!)\n    htmx.trigger(ohlc, 'reload');\n}\n\nfunction createDataRow(tableHeader) {\n    const rows = document.createElement('div');\n    rows.className = 'usr-table-row';\n    Object.assign(rows.style, {\n        minWidth: '100%',\n        justifyContent: tableHeader.style.justifyContent\n    });\n\n    copyStyles(tableHeader, rows, [\"row-gap\", \"column-gap\"]);\n    return rows;\n}\n\nfunction Tp_Vals() {\n\n    if (!event) {\n        return;\n    }\n    const target = event.target;\n    console.log(event);\n    if (!target.classList?.contains('changed_planes')) {\n        return;\n    }\n\n    const form = target.closest('form');\n    if (!form) return {};\n\n    return collectFormState(form);\n\n    let result = {};\n    $('div[data-id]:has(select, textarea, input)', form).each( (ind, el) => {\n        let obj = {}\n        $('select, textarea, input', el).each( (ind, el) => {\n            obj[el.name] = el.value;\n        });\n        result[el.dataset[\"id\"]] = obj;\n    });\n\n    $('.usr-table-row:has(div select), .usr-table-row:has(div textarea), .usr-table-row:has(div input)').each( (ind, el) => {\n        let obj = {}\n        $('select, textarea, input', el).each( (ind, el) => {\n            obj[el.name] = el.value;\n        });\n        result[el.children[0].textContent] = obj;\n    });\n\n    return result;\n}\n\nfunction collectFormState(form) {\n    const result = {};\n\n    form.querySelectorAll('.usr-table-row, div[data-id]').forEach(row => {\n        const obj = {};\n\n        row.querySelectorAll('input, textarea, select').forEach(el => {\n            if (el.form !== form) return;\n            if (!el.name || el.disabled) return;\n\n            if (el.type === 'checkbox') {\n                obj[el.name] = el.checked;\n            } else {\n                if (obj[el.name]) {\n                    if (!Array.isArray(obj[el.name])) {\n                        obj[el.name] = [obj[el.name]];\n                    }\n                    obj[el.name].push(el.value);\n                } else {\n                    obj[el.name] = el.value;\n                }\n            }\n        });\n\n        if (Object.keys(obj).length === 0) return;\n\n        const key = row?.dataset?.[\"id\"] ?? row.children[0]?.textContent?.trim();\n        if (key) result[key] = obj;\n    });\n\n    return result;\n}\n\nfunction getMathSymbol(total) {\n    switch (total.toLowerCase()) {\n        case 'sum':\n            return ''; //'∑'; set zero // summation\n        case 'avg':\n        case 'mean':\n            return '𝑥̄'; // x-bar for average\n        case 'min':\n            return '⩘'; // minimum\n        case 'max':\n            return '⩓'; // maximum\n        case 'count':\n        case 'cnt':\n        case 'n':\n            return '#'; // count\n        case 'median':\n        case 'med':\n            return 'M'; // median\n        case 'stdev':\n        case 'stddev':\n        case 'sd':\n            return 'σ'; // standard deviation\n        case 'var':\n        case 'variance':\n            return 'σ²'; // variance\n        case 'aad':\n        case 'mad':\n        case 'deviation':\n            return 'Δ'; // absolute deviation\n        default:\n            return ''; // unknown → no symbol\n    }\n}\n\nfunction writeChildren(first, header, i, value, rows) {\n    let cell = first.cloneNode(true);\n    cell.className = `usr-table-cell${header.name} usr-table-col usr-table-cell${header.name}${i+1}`;\n    cell.textContent = convertTableValue(cell, header, value);\n    rows.appendChild(cell);\n    if (header.dataCell.textContent.length < cell.textContent.length) {\n        header.dataCell = cell;\n    }\n    return cell.textContent;\n}\n\nfunction changeOrCreateCssClass(className, newStyles) {\n    changeOrCreateCssSelector(`.${className}`, newStyles);\n}\nfunction changeOrCreateCssSelector(selector, newStyles) {\n    let selFound = false;\n\n    // Go through all stylesheets\n    for (const sheet of document.styleSheets) {\n        // skip all import css\n        if (sheet.href && sheet.href.startsWith(\"http\")) {\n            continue\n        }\n\n        try {\n            for (const rule of sheet.cssRules || sheet.rules) {\n                if (rule.selectorText === selector) {\n                    for (const [prop, value] of Object.entries(newStyles)) {\n                        rule.style[prop] = value;\n                    }\n                    selFound = true;\n                    break;\n                }\n            }\n        } catch (e) {\n            console.warn(\"Skipping stylesheet due to CORS restrictions:\", sheet.href);\n        }\n\n        if (selFound) break;\n    }\n\n    if (!selFound) {\n        // If class doesn't exist, create it\n        const styleEl = document.createElement(\"style\");\n        styleEl.type = \"text/css\";\n\n        // Convert camelCase to kebab-case and generate the CSS string\n        const cssProps = Object.entries(newStyles)\n            .map(([prop, value]) => {\n                const kebabProp = prop.replace(/([A-Z])/g, \"-$1\").toLowerCase();\n                return `  ${kebabProp}: ${value};`;\n            })\n            .join(\"\\n\");\n\n        const cssRule = `${selector} {\\n${cssProps}\\n}`;\n        styleEl.appendChild(document.createTextNode(cssRule));\n        document.head.appendChild(styleEl);\n\n        // console.debug(`Created new selector '${selector}'`);\n    }\n}\n\nfunction parseNumber(text) {\n    if (!text) return NaN;\n    // remove thousands separators (commas), keep dot as decimal\n    let cleaned = text.replace(/,/g, '');\n    if (/^\\d+\\.\\d{0,2}/.test(cleaned)) {\n\n        if (cleaned.startsWith('(')) {\n            cleaned = '-' + cleaned.slice(1, -1);\n        }\n        return parseFloat(cleaned);\n    }\n    return NaN;\n}\n\nfunction fancyOpen(data) {\n    $.fancybox.open({\n        'autoScale': true,\n        'transitionIn': 'elastic',\n        'transitionOut': 'elastic',\n        'speedIn': 500,\n        'speedOut': 300,\n        'type': 'html',\n        'autoDimensions': true,\n        'centerOnScroll': true,\n        'content': data\n    })\n}\n\nfunction fancyOpenComponent(elem, tpl) {\n\n    showDialog(createInstanceByClass(tpl));\n    return;\n    // let elem = event.target;\n    $.fancybox.open({\n        'autoScale': true,\n        'transitionIn': elem?.dataset[\"transition\"] || 'elastic',\n        'transitionOut': elem?.dataset[\"transition\"] || 'elastic',\n        'speedIn':  elem?.dataset[\"duration\"] || 500,\n        'speedOut': elem?.dataset[\"duration\"] || 300,\n        'type': 'html',\n        // 'autoDimensions': true,\n        'centerOnScroll': true,\n        'content': createInstanceByClass(tpl)\n    });\n    // post preparing\n    setTimeout(function () {\n        processAll('.fancybox-inner');\n    }, 1000);\n}\n\nfunction fancyOpenElement(elem) {\n    $.fancybox.open({\n        'autoScale': true,\n        'transitionIn': 'elastic',\n        'transitionOut': 'elastic',\n        'speedIn': 500,\n        'speedOut': 300,\n        'type': 'html',\n        // 'autoDimensions': true,\n        'centerOnScroll': true,\n        'content': elem\n    });\n    setTimeout(function () {\n        processAll('.fancybox-inner');\n    }, 1000);\n}\n\nfunction showDialog(component, parent) {\n\n    let target = event.currentTarget; // impotent! not target\n    if (target.overlay) {\n        return;\n    }\n    let dlg = target.overlay || createAndAddInstance(parent || document.body, component);\n    target.overlay = dlg;\n    // Make dialog visible\n    Object.assign(dlg.style, {\n        // left: '-10000px',\n        top: '50%',\n        left: '50%',\n        height: '96%',\n        visibility: 'visible',\n        position: 'absolute',\n        display: \"\",\n        opacity: \"1\",\n        transform: 'translate(-50%, -50%)',\n        zIndex: '999999',\n        // height: `${document.body.clientHeight - 5}px`,\n        // width: `${elem.getBoundingClientRect().width - left}px`\n    });\n    dlg.hidden = false;\n\n    const duration =\n        Number(dlg.dataset.duration ?? 300);\n\n    const easing =\n        dlg.dataset.easing ?? \"ease-out\";\n\n    const transition =\n        dlg.dataset.transition ?? \"instant\";\n\n    const direction =\n        dlg.dataset.direction ?? \"left\";\n\n    switch (transition) {\n\n        case \"instant\":\n            return dlg;\n\n        case \"dissolve\":\n            anime({\n                targets: dlg,\n                opacity: [0, 1],\n                duration,\n                easing\n            });\n            break;\n\n        case \"move-in\": {\n\n            let x = 0;\n            let y = 0;\n\n            switch (direction) {\n                case \"left\":   x = \"-100%\"; break;\n                case \"right\":  x = \"100%\";  break;\n                case \"top\":    y = \"-100%\"; break;\n                case \"bottom\": y = \"100%\";  break;\n            }\n\n            anime({\n                targets: dlg,\n                translateX: [x, 0],\n                translateY: [y, 0],\n                opacity: [1, 1],\n                duration,\n                easing\n            });\n\n            break;\n        }\n\n        case \"slide-in\": {\n\n            let x = 0;\n            let y = 0;\n\n            switch (direction) {\n                case \"left\":   x = \"-100%\"; break;\n                case \"right\":  x = \"100%\";  break;\n                case \"top\":    y = \"-100%\"; break;\n                case \"bottom\": y = \"100%\";  break;\n            }\n\n            anime({\n                targets: dlg,\n                translateX: [x, 0],\n                translateY: [y, 0],\n                duration,\n                easing\n            });\n\n            break;\n        }\n\n        case \"move-out\":\n        case \"slide-out\":\n        case \"push\":\n        case \"smart-animate\":\n            // implement later\n            break;\n    }\n\n    return dlg;\n}\n\nfunction closeDialog(id) {\n\n    const dlg = document.getElementById(id);\n\n    if (!dlg)\n        return;\n\n    const duration =\n        Number(dlg.dataset.duration ?? 300);\n\n    anime({\n        targets: dlg,\n        opacity: 0,\n        duration,\n        complete() {\n            dlg.classList.add(\"hidden\");\n            dlg.style.opacity = \"\";\n        }\n    });\n}\nfunction showErrors(formErrors, thisForm) {\n    if (formErrors) {\n        let out = $('output', thisForm);\n        for (let key in formErrors) {\n            let elem = $(`[name=\"${key}\"]`, thisForm);\n            if (elem.length > 0) {\n                elem.nextAll('.errorLabel').show().text(formErrors[key]);\n                elem.addClass('error-field').focus();\n                if (elem.nextAll('.errorLabel').length === 0) {\n                    elem.after(`<h6 class=\"errorLabel\" style=\"display:flex; font-size: smaller\"> ${formErrors[key]} </h6>`);\n                }\n                elem.parents('details').attr('open', true);\n            } else {\n                out.text(formErrors[key]).addClass('htmx-swap-error');\n            }\n        }\n    }\n}\n\n// temporary for form\nfunction saveForm(thisForm, successFunction, errorFunction) {\n    let title = $('h2', thisForm).text() || $('figcaption', thisForm).text() || $(thisForm).attr('name') || thisForm.id;\n        // nav = getFormNav(thisForm);\n    // hidden fields of not used blocks\n    $('form figure:hidden:not([validated]) .input-label').children('input, select').attr('disabled', true);\n\n    // if (!validateFields(thisForm))\n    //     return false;\n\n    if (thisForm.noValidate && !confirm(`Do you sure to send form \"${title}\"?`)) {\n        return true;\n    }\n    // TODO: create element form for output form result\n    const $out = $('output', thisForm),\n        $loading = $('.loading', thisForm),\n        $progress = $('progress', thisForm);\n\n    $(thisForm).ajaxSubmit({\n        beforeSubmit: function (a, f, o) {\n            o.dataType = \"json\";\n\n            // rm field without values\n            var isNewRecord = $('input[name=id]').length === 0;\n\n            for (var i = a.length - 1; i >= 0; --i) {\n                if (a[i].readOnly\n                    || ((a[i].value === '') && (isNewRecord || a[i].type === 'select-one' || a[i].type === 'file'))\n                    || (a[i].value.length === 0)) {\n                    let t = a.splice(i, 1);\n                    console.log(t);\n                }\n            }\n\n            $(\"input[type=checkbox][checked]:not(:checked)\", f).each(function () {\n                a.push({name: this.name, value: 0, type: this.type, required: this.required});\n            });\n            a.push({name: \"is_get_form_actions\", value: true, type: \"boolean\"});\n            $out.html('Start sending...');\n            $('.errorLabel').hide();\n            $progress.show();\n            $loading.show();\n        },\n        beforeSend: (xhr) => {\n            getHeaders(xhr);\n            // xhr.setRequestHeader(\"Content-Type\", \"application/octet-stream\");\n        },\n        uploadProgress: (event, position, total, percentComplete) => {\n            console.log(event, position, total, percentComplete);\n            $out.html('Progress - ' + percentComplete + '%');\n            $progress.val(percentComplete);\n        },\n        statusCode: {\n            206: (data, status, xhr) => {\n                console.log(status);\n                console.log(data);\n                console.log(xhr);\n            }\n        },\n        success: (data, status, xhr) => {\n            if (xhr.status === 206) {\n                readEvents($out, data);\n                return\n            }\n            $out.html(status);\n            // TODO: добавить загрузку скрипта, если функция определена, но не подключена!\n            if (successFunction !== undefined) {\n                successFunction(data, thisForm);\n            } else {\n                afterSaveAnyForm(data, status);\n            }\n            $.fancybox.close();\n        },\n        error: function (xhr, status, error) {\n            if (errorFunction !== undefined) {\n                errorFunction(error, thisForm);\n            } else {\n                $out.html(xhr.responseText);\n                switch (xhr.status) {\n                    case 206: {\n                        fancyOpen(xhr.responseText);\n                        return\n                    }\n                    case 400: {\n                        showErrors(xhr.responseJSON.formErrors, thisForm);\n                        return\n                    }\n                    case 401: {\n                       return relogin();\n                    }\n\n                    default:\n                        alert(xhr.responseText);\n                }\n            }\n        },\n        complete: function (xhr, status, obj) {\n            $progress.hide();\n            $loading.hide();\n            console.log(xhr);\n            console.log(obj);\n        }\n    });\n\n    return false;\n}\n\n// handling response AnyForm & render result according to structures of data\nfunction afterSaveAnyForm(data, status) {\n\n    if (data.content_url !== undefined) {\n        loadContent(data.content_url);\n    } else if (data.formActions !== undefined) {\n        loadContent(data.formActions[0].url);\n    } else if (data.error !== undefined) {\n        alert(data.error);\n    } else {\n        console.log(data);\n    }\n\n    if (data.message !== undefined) {\n        alert(data.message);\n    }\n}\n\nfunction CloseParent() {\n    const event = window.event;\n    const parent = (event.target || event.currentTarget).closest('component');\n\n    $(parent).hide();\n\n    return false;\n}\n\nfunction FormIsModified() {\n    const event = window.event;\n    const form = (event.target || event.currentTarget).closest('form');\n\n    $('button.hidden', form).show().addClass('main-btn').removeClass('hidden');\n    $('button[disabled]', form) .removeAttr('disabled');\n}\n\n/**\n * @typedef {Object} TableContainer\n * @property {number} x - Координата X.\n * @property {number} y - Координата Y.\n */\n/**\n * Load script according to params if parent consist of any chart templartes. *\n * @param {string} url - url of script.\n * @param {boolean} asyncS - async loading.\n * @param {boolean} cacheS - use cache.\n * @param {function} successFunc .\n * @param {function} completeFunc.\n * @returns {void}\n */\n\nfunction LoadJScript(url, asyncS, cacheS, successFunc, completeFunc) {\n    $.ajax({\n        type: \"GET\",\n        async: asyncS,\n        cache: cacheS,\n        url: url,\n        global: false,\n        dataType: \"script\",\n        success: successFunc,\n        complete: completeFunc,\n        error: errorLoadResource\n    });\n}\n\nfunction loadCSSOnce(url) {\n    if (document.querySelector(`link[href=\"${url}\"]`)) return;\n\n    const link = document.createElement(\"link\");\n    link.rel = \"stylesheet\";\n    link.href = url;\n    document.head.appendChild(link);\n}\n\nfunction errorLoadResource(xhr, textStatus, errorThrown) {\n    if (errorThrown) {\n        console.error(`%s from '${this.url}'! (${textStatus}). Pls, reload page!`, errorThrown);\n    } else {\n        console.error(`Can't load resource from '${this.url}'! (${textStatus}). Pls, reload page! %s`, textStatus);\n    }\n}\n\nfunction validatePattern(thisElem) {\n    let re = thisElem.pattern,\n        result = true;\n\n    let value = thisElem.value;\n    if (re === \"\" || (!thisElem.required && !thisElem.validity.badInput)) {\n        return true;\n    }\n\n    try {\n\n        re = new RegExp(re);\n        result = re.test(value);\n        if (result) {\n            $(thisElem).addClass('validated-field').removeClass('error-field');\n            $(thisElem).nextAll('.errorLabel').hide();\n        } else {\n            $(thisElem).addClass('error-field').removeClass('validated-field');\n            $(thisElem).nextAll('.errorLabel').show();\n        }\n\n    } catch (e) {\n        console.log(e)\n    }\n\n    return result;\n}\n\nfunction FullScreenParrent(elem) {\n    const container = elem.parentNode.parentNode.parentNode;\n    if (!document.fullscreenElement) {\n        container.requestFullscreen();\n    } else {\n        document.exitFullscreen();\n    }\n    return false\n}\n\n// show files preview on form\nfunction handleFileOnForm(evt) {\n    let files = evt.files || evt.target.files; // FileList object\n    if (files.length < 1)\n        return false;\n\n    let el = evt.target || evt.currentTarget;\n    let $progress = $('#progress', $(el).closest('form')).show(),\n        img = $(el).parent(),\n        // reader = new FileReader(),\n        f = files[0];\n\n    // reader.onload = (function (theFile) {\n    //     return function (e) {\n    if (f.type.match('(image.*)|(application/pdf)')) {\n        img.css({\n            'background-image': `url(${window.URL.createObjectURL(f)})`,\n            'background-size': 'cover',\n        });\n    } else {\n        console.log(f);\n        alert(f.type)\n    }\n    img.attr('data-placeholder', f.name);\n}\n\nfunction navigateToPage(event, url) {\n    const isMiddleClick = event.button === 1;\n    const isNewTab = event.ctrlKey || event.metaKey || isMiddleClick;\n    const isNewWindow = event.shiftKey && !isNewTab;\n\n    if (isNewWindow) {\n        // Shift + click: request a separate window.\n        window.open(url, \"_blank\", \"popup=yes\");\n        return;\n    }\n\n    if (isNewTab) {\n        // Ctrl/Cmd + click, middle click, Ctrl/Cmd + Shift + click:\n        // browser opens a new tab/window according to user preferences.\n        window.open(url, \"_blank\", \"noopener\");\n        return;\n    }\n\n    // Plain left click\n    window.location.assign(url);\n}\n"
