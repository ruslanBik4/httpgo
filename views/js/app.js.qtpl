{% func App() %}
{%= UserJS() %}
{%= SetClicksJS()  %}
{%= Observer()  %}
	{% cat "src/app.js" %}
{% endfunc %}

// add all functional for httpgo web apps
{% func AppMax() %}
{%= App() %}
{%= PutFormsJS() %}
{%= TableJS() %}
{%= SetFlatPickr() %}
{%= Observer()  %}
$(function () {
    if (document.body.querySelector('[hx-ext="json-swap"]')  !== null) {
        {%= HtmxJson() %}
    }
});
{% endfunc %}