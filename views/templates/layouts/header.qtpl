{% func HeaderHTML(TopMenu Menu) %}{%= HeaderSearchHTML(TopMenu, nil) %}{% endfunc %}

{% comment %}
HeaderSearchHTML is the header with the top menu and the search panel in ONE flowing
row (see ".topline" / ".header-search" in styles.css): the search takes the free
space after the menu, and wraps under it on a narrow screen. Search == nil gives
the plain header.
{% endcomment %}
{% func HeaderSearchHTML(TopMenu Menu, Search *SearchPanel) %}
<header class="main-header">
<div class="topline">
    <a class="home-link" href="/" title="Home" aria-label="Home"><img src="/favicon.ico" alt="" width="24" height="24"
        onerror="this.replaceWith(Object.assign(document.createElement('i'), {className: 'bi bi-house-door'}))"></a>
    <nav class="topline-navbar">
        {%= TopMenu.RenderMenu("top-mnu-list navbar-nav", "top-mnu-item") %}
    </nav>
    {%- if Search != nil -%}
    <div class="header-search">{%= Search.Render() %}</div>
    {%- endif -%}
    <div class="topline-btns">
    <ul class="burger-list">
    <li>
        <span id="sUser"> </span>
	    <ul class="dropdown">
		    <li class="top-mnu-item before-login">
			    <a id="bLogin" href="/show/forms/signin" class="navbar-link btn-login" title="Open auth form" hx-swap="none"  data-fancybox >
			       <span class="glyphicon-info-sign">SignIn</span>
			    </a>
		    </li>
		    <li class="top-mnu-item before-login">
		        <a id="bSignUp" href="/show/forms/signup" class="navbar-link btn-login" title="Open registration form" hx-swap="none"  data-fancybox >
		        <span class="glyphicon-info-sign">SignUp</span>
		        </a>
		    </li>
		    <li class="top-mnu-item after-login">
                <a href="/auth/logout" id="bLogOut" onclick="return logOut(this);">
		            <span class="glyphicon-log-out">Logout</span>
                </a>
		    </li>
	    </ul>
    </li>
    </ul>
    </div>
</div>
</header>
{% endfunc %}